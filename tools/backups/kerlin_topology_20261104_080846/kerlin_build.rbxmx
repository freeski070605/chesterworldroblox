          <Item class="Script" referent="1652">
            <Properties>
              <string name="Name">RoadTerrainConformer</string>
              <token name="RunContext">0</token>
              <string name="Source"><![CDATA[-- ChesterWorld - I-95 / bridge / ramp elevation owner.
-- Ground intersections stay owned by TileBuilderV3, with zero modification.
-- This script runs after all regional tiles have been built.
-- Orientation lock: NORTH=-Z, EAST=+X.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("WorldConfig"))
local Terrain = Workspace.Terrain

Workspace:SetAttribute("CW_RoadConformComplete", false)
while Workspace:GetAttribute("CW_BootstrapComplete") ~= true do task.wait(0.2) end
local world = Workspace:WaitForChild("ChesterWorld")

local CELL = 120
local END_CELL = 12
local CONNECT = Config.HIGHWAY_BRIDGE_CONNECT_TOLERANCE_STUDS or 6
local ROAD_OFFSET = Config.ROAD_SURFACE_OFFSET_STUDS or 0.3
local MARK_OFFSET = Config.CENTERLINE_SURFACE_OFFSET_STUDS or 0.58
local CLEARANCE = Config.HIGHWAY_MIN_CLEARANCE_STUDS or 18
local MAX_LIFT = Config.HIGHWAY_MAX_DECK_LIFT_STUDS or 65
local MAX_RAMP = Config.HIGHWAY_APPROACH_LENGTH_STUDS or 300
local MAX_GRADE = Config.HIGHWAY_MAX_APPROACH_GRADE or 0.10

local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.FilterDescendantsInstances = {Terrain}
terrainParams.IgnoreWater = false

local function terrainY(x, z)
    local result = Workspace:Raycast(
        Vector3.new(x, 3000, z), Vector3.new(0, -6000, 0), terrainParams)
    return result and result.Position.Y or nil
end

-- Estimated small import-seam gaps; do not extrapolate farther than 16 studs.
local function terrainYNearby(x, z)
    local exact = terrainY(x, z)
    if exact then return exact, false end
    for _, radius in ipairs({8, 16}) do
        local samples = {}
        for _, vector in ipairs({
            {1,0}, {-1,0}, {0,1}, {0,-1},
            {0.707,0.707}, {-0.707,0.707},
            {0.707,-0.707}, {-0.707,-0.707},
        }) do
            local y = terrainY(x + vector[1]*radius, z + vector[2]*radius)
            if y then table.insert(samples, y) end
        end
        if #samples >= 2 then
            local total = 0
            for _, y in ipairs(samples) do total += y end
            return total/#samples, true
        end
    end
    return nil, false
end

local function hdist(a, b)
    local dx, dz = a.X - b.X, a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end

local function smoothstep(t)
    t = math.clamp(t, 0, 1)
    return t * t * (3 - 2 * t)
end

local function lerp(a, b, t) return a + (b - a) * math.clamp(t, 0, 1) end
local function attr(p, name) return tostring(p:GetAttribute(name) or "") end

local function endpoints(part)
    -- TileBuilder uses length on Size.Z and CFrame.lookAt. Use its TRUE 3D
    -- endpoints, not Size.Z as a horizontal distance (that made bridge gaps).
    local delta = part.CFrame.LookVector * (part.Size.Z / 2)
    return part.Position - delta, part.Position + delta
end

local function setEndpoints(part, a, b)
    local diff = b - a
    if diff.Magnitude < 0.1 then return false end
    local width, thickness = part.Size.X, part.Size.Y
    part.Size = Vector3.new(width, thickness, diff.Magnitude)
    part.CFrame = CFrame.lookAt((a + b) / 2, b, Vector3.yAxis)
    return true
end

local function horizontalUnit(v)
    local h = Vector3.new(v.X, 0, v.Z)
    return h.Magnitude > 0.01 and h.Unit or nil
end

local function gridKey(x, z, cell)
    return math.floor(x / cell) .. ":" .. math.floor(z / cell)
end

local function addEndpoint(index, point, obj)
    local key = gridKey(point.X, point.Z, END_CELL)
    index[key] = index[key] or {}
    table.insert(index[key], {pos = point, obj = obj})
end

local function nearbyEndpoints(index, point)
    local cx, cz = math.floor(point.X / END_CELL), math.floor(point.Z / END_CELL)
    local results = {}
    for dx = -1, 1 do
        for dz = -1, 1 do
            for _, item in ipairs(index[(cx + dx) .. ":" .. (cz + dz)] or {}) do
                if hdist(item.pos, point) <= CONNECT then
                    table.insert(results, item)
                end
            end
        end
    end
    return results
end

local function highwayRoad(part)
    local cls = string.lower(attr(part, "CW_RoadClass"))
    local name = string.lower(attr(part, "ChesterStreet"))
    return cls == "motorway" or cls == "motorway_link"
        or cls == "trunk" or cls == "trunk_link"
        or string.find(name, "i 95", 1, true) ~= nil
        or string.find(name, "i-95", 1, true) ~= nil
end

-- Names from county and OSM often vary only in punctuation/suffix.
-- Match continuity by actual road name without joining unrelated streets.
local function normalizedRoadName(name)
    local value = string.lower(tostring(name or ""))
    value = value:gsub("[^%w%s]", " "):gsub("%s+", " ")
    value = value:gsub("^%s+", ""):gsub("%s+$", "")
    local suffixes = {
        "%s+street$", "%s+st$", "%s+avenue$", "%s+ave$",
        "%s+boulevard$", "%s+blvd$", "%s+road$", "%s+rd$",
    }
    for _, suffix in ipairs(suffixes) do
        value = value:gsub(suffix, "")
    end
    return value
end

local function collectParts(folderName)
    local result = {}
    for _, tile in ipairs(world:GetChildren()) do
        local folder = tile:FindFirstChild(folderName)
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("BasePart") then table.insert(result, obj) end
            end
        end
    end
    return result
end

local allRoads = collectParts("Roads")
local allMarks = collectParts("RoadMarkings")
local atGrade, bridges, tunnelParts = {}, {}, 0
local approachIndex, underRoadGrid = {}, {}

local function addGroundGrid(part)
    local a, b = endpoints(part)
    local halfWidth = part.Size.X / 2
    local minX = math.min(a.X, b.X) - halfWidth
    local maxX = math.max(a.X, b.X) + halfWidth
    local minZ = math.min(a.Z, b.Z) - halfWidth
    local maxZ = math.max(a.Z, b.Z) + halfWidth
    for gx = math.floor(minX / CELL), math.floor(maxX / CELL) do
        for gz = math.floor(minZ / CELL), math.floor(maxZ / CELL) do
            local key = gx .. ":" .. gz
            underRoadGrid[key] = underRoadGrid[key] or {}
            table.insert(underRoadGrid[key], part)
        end
    end
end

for _, part in ipairs(allRoads) do
    local level = tonumber(part:GetAttribute("CW_GradeLevel")) or 0
    local isBridge = part:GetAttribute("CW_Bridge") == true or level > 0
    if isBridge then
        local key = attr(part, "CW_GradeGroup")
        if key == "" then
            key = attr(part, "ChesterStreet") .. ":g" .. level
        end
        bridges[key] = bridges[key] or {}
        table.insert(bridges[key], part)
    else
        table.insert(atGrade, part)
        addGroundGrid(part)
        if part:GetAttribute("CW_Tunnel") == true or level < 0 then
            tunnelParts += 1
        end
        -- All bridge types need realistic approaches, not just I-95.
        -- Index named ground roads; the chain search below still requires
        -- name/direction agreement, so cross streets cannot be pulled upward.
        local cls = string.lower(attr(part, "CW_RoadClass"))
        if level == 0 and part:GetAttribute("CW_Tunnel") ~= true
            and normalizedRoadName(attr(part, "ChesterStreet")) ~= ""
            and normalizedRoadName(attr(part, "ChesterStreet")) ~= "road"
            and cls ~= "service" and cls ~= "alley" then
            local a, b = endpoints(part)
            addEndpoint(approachIndex, a, part)
            addEndpoint(approachIndex, b, part)
        end
        part:SetAttribute("CW_TerrainConformed", true)
        part:SetAttribute("CW_ElevationOwner", "TileBuilderV3")
    end
end

-- A grade group may have several disconnected spans or carriageways.
-- Never force unrelated components through one shared start/end profile.
local function components(parts)
    local groups, seen = {}, {}
    for _, first in ipairs(parts) do
        if not seen[first] then
            local queue, component = {first}, {}
            seen[first] = true
            local head = 1
            while head <= #queue do
                local part = queue[head]
                head += 1
                table.insert(component, part)
                local a, b = endpoints(part)
                for _, other in ipairs(parts) do
                    if not seen[other] then
                        local x, y = endpoints(other)
                        if hdist(a, x) <= CONNECT or hdist(a, y) <= CONNECT
                            or hdist(b, x) <= CONNECT or hdist(b, y) <= CONNECT then
                            seen[other] = true
                            table.insert(queue, other)
                        end
                    end
                end
            end
            table.insert(groups, component)
        end
    end
    return groups
end

local function dominantDirection(parts)
    local total, ref = Vector3.zero, nil
    for _, part in ipairs(parts) do
        local a, b = endpoints(part)
        local v = horizontalUnit(b - a)
        if v then
            if not ref then ref = v end
            if v:Dot(ref) < 0 then v = -v end
            total += v * hdist(a, b)
        end
    end
    return horizontalUnit(total) or ref or Vector3.new(1, 0, 0)
end

local function crossingT(a, b, c, d)
    local rx, rz = b.X - a.X, b.Z - a.Z
    local sx, sz = d.X - c.X, d.Z - c.Z
    local det = rx * sz - rz * sx
    if math.abs(det) < 0.001 then return nil end
    local dx, dz = c.X - a.X, c.Z - a.Z
    local t = (dx * sz - dz * sx) / det
    local u = (dx * rz - dz * rx) / det
    if t > 0.02 and t < 0.98 and u > 0.02 and u < 0.98 then
        return t, u
    end
    return nil
end

local function underRoadsForSegment(a, b)
    local visited, found = {}, {}
    local minGX = math.floor(math.min(a.X, b.X) / CELL) - 1
    local maxGX = math.floor(math.max(a.X, b.X) / CELL) + 1
    local minGZ = math.floor(math.min(a.Z, b.Z) / CELL) - 1
    local maxGZ = math.floor(math.max(a.Z, b.Z) / CELL) + 1
    for gx = minGX, maxGX do
        for gz = minGZ, maxGZ do
            for _, road in ipairs(underRoadGrid[gx .. ":" .. gz] or {}) do
                if not visited[road] then
                    visited[road] = true
                    table.insert(found, road)
                end
            end
        end
    end
    return found
end

local rampUsed = {}
local function findApproachChain(terminal, outward, bridgeName)
    local chain, used = {}, {}
    local current = terminal
    local distance = 0
    while distance < MAX_RAMP do
        local best, bestScore, bestFar = nil, -math.huge, nil
        for _, item in ipairs(nearbyEndpoints(approachIndex, current)) do
            local part = item.obj
            if not used[part] and not rampUsed[part] then
                local x, y = endpoints(part)
                local far = hdist(x, item.pos) < hdist(y, item.pos) and y or x
                local away = horizontalUnit(far - current)
                if away and hdist(far, current) > 0.5 then
                    local dot = away:Dot(outward)
                    local partName = attr(part, "ChesterStreet")
                    local matchName =
                        normalizedRoadName(partName) ~= ""
                        and normalizedRoadName(partName) == normalizedRoadName(bridgeName)
                    local cls = string.lower(attr(part, "CW_RoadClass"))
                    local isLink = cls == "motorway_link" or cls == "trunk_link"
                    local bridgeI95 = string.find(string.lower(bridgeName),
                        "i 95",1,true) ~= nil or
                        string.find(string.lower(bridgeName),
                        "i-95",1,true) ~= nil
                    local approachI95 = string.find(string.lower(partName),
                        "i 95",1,true) ~= nil or
                        string.find(string.lower(partName),
                        "i-95",1,true) ~= nil
                    local related = matchName or
                        (bridgeI95 and approachI95) or
                        (isLink and bridgeI95)
                    -- Don't follow arbitrary nearby streets through a sharp
                    -- turn. The old 0.24 dot threshold could grab a road at
                    -- ~76 degrees and manufacture a steep "ramp".
                    local score = dot + (matchName and 0.5 or 0)
                    if related and dot > 0.70 and score > bestScore then
                        best, bestScore, bestFar = part, score, far
                    end
                end
            end
        end
        if not best then break end
        local near = current
        local segmentLength = hdist(near, bestFar)
        table.insert(chain, {
            part = best, near = near, far = bestFar,
            startDistance = distance,
            endDistance = distance + segmentLength,
        })
        used[best] = true
        distance += segmentLength
        local newAway = horizontalUnit(bestFar - near)
        if newAway then outward = newAway end
        current = bestFar
    end
    return chain, math.min(distance, MAX_RAMP)
end

local profilesByGroup = {}
local rampsByGroup = {}

-- Source grade_group is usually a single county feature ID. Adjacent pieces
-- of the SAME elevated roadway often get different IDs; profiling each one
-- creates dozens of 24-60 stud "bridges" with no room for a real slope.
-- Group by normalized name + elevation layer, then split by actual shared
-- endpoints. Two parallel carriageways remain separate unless connected.
local corridorBridges = {}
local sourceBridgeGroups = 0
for _, group in pairs(bridges) do
    sourceBridgeGroups += 1
    for _, part in ipairs(group) do
        local level = tonumber(part:GetAttribute("CW_GradeLevel")) or 0
        local cleanName = normalizedRoadName(attr(part, "ChesterStreet"))
        local key = cleanName .. ":elevation:" .. tostring(level)
        if cleanName == "" or cleanName == "road" then
            key = attr(part, "CW_GradeGroup")
        end
        corridorBridges[key] = corridorBridges[key] or {}
        table.insert(corridorBridges[key], part)
    end
end

local stats = {
    groups = 0, components = 0, bridgeParts = 0, bridgeConformed = 0,
    bridgeNoTerrain = 0, failed = 0, tunnelParts = tunnelParts,
    rampParts = 0, rampGroups = 0, marked = 0,
    crossingChecks = 0, clearanceWarnings = 0, steepGroups = 0,
    terrainClearanceWarnings = 0, terrainEndpointEstimates = 0,
    insufficientApproachLength = 0, gradeLimitedParts = 0,
    actualSteepParts = 0, baselineSteepGroups = 0,
}

local function conformComponent(parts, groupKey)
    local direction = dominantDirection(parts)
    local records, low, high = {}, math.huge, -math.huge
    local lowPoint, highPoint = nil, nil
    local nominalClearance = CLEARANCE

    for _, part in ipairs(parts) do
        local a, b = endpoints(part)
        local ta = a.X * direction.X + a.Z * direction.Z
        local tb = b.X * direction.X + b.Z * direction.Z
        if ta > tb then a, b, ta, tb = b, a, tb, ta end
        table.insert(records, {part = part, a = a, b = b, pa = ta, pb = tb})
        if ta < low then low, lowPoint = ta, a end
        if tb > high then high, highPoint = tb, b end
        nominalClearance = math.max(nominalClearance,
            tonumber(part:GetAttribute("CW_GradeClearanceStuds")) or 0)
    end

    if not lowPoint or not highPoint then return nil end
    local startGround, estimatedStart = terrainYNearby(lowPoint.X, lowPoint.Z)
    local endGround, estimatedEnd = terrainYNearby(highPoint.X, highPoint.Z)
    if not startGround or not endGround then
        stats.bridgeNoTerrain += #parts
        return nil
    end

    if estimatedStart or estimatedEnd then
        stats.terrainEndpointEstimates +=
            (estimatedStart and 1 or 0) + (estimatedEnd and 1 or 0)
        for _, part in ipairs(parts) do
            part:SetAttribute("CW_TerrainEndpointEstimated", true)
        end
    end

    local span = math.max(high - low, 0.1)
    local bridgeName = attr(parts[1], "ChesterStreet")
    local rampStart, startLength = {}, 0
    local rampEnd, endLength = {}, 0
    -- This applies to I-95 AND short local overpasses such as Macdade,
    -- Flower and Melrose. With no valid matching continuation, leave it
    -- flagged rather than attaching an unrelated roadway.
    rampStart, startLength = findApproachChain(lowPoint, -direction, bridgeName)
    rampEnd, endLength = findApproachChain(highPoint, direction, bridgeName)

    -- A smoothstep transition has a maximum derivative of 1.5.
    -- Limit bridge terminal lift to what an actual adjacent ramp can absorb.
    local startLift = math.min(nominalClearance, startLength * MAX_GRADE / 1.5)
    local endLift = math.min(nominalClearance, endLength * MAX_GRADE / 1.5)
    local targetLift = nominalClearance

    -- Ground streets are left untouched; raise a deck enough to clear them.
    local crossings = {}
    for _, rec in ipairs(records) do
        for _, lower in ipairs(underRoadsForSegment(rec.a, rec.b)) do
            local x, y = endpoints(lower)
            local t, u = crossingT(rec.a, rec.b, x, y)
            if t then
                local position = rec.a:Lerp(rec.b, t)
                local station = (position.X * direction.X
                    + position.Z * direction.Z - low) / span
                local groundTop = lerp(x.Y, y.Y, u) + lower.Size.Y / 2
                local baseline = lerp(startGround, endGround, station)
                    + ROAD_OFFSET + rec.part.Size.Y / 2
                local needed = groundTop + CLEARANCE
                    + (Config.HIGHWAY_DECK_THICKNESS_STUDS or 1.6) - baseline
                targetLift = math.max(targetLift, needed)
                table.insert(crossings, {t = station, needed = needed})
            end
        end
    end
    -- The previous solver checked the HIGH point only, yet some decks were
    -- still embedded on their sloping quarters. Record actual requirements
    -- at each bridge station and solve for the lifted envelope at THAT t.
    -- Ends are abutments and may be buried in the bank; we sample a little
    -- inside the span to avoid incorrectly requiring an elevated terminal.
    local terrainRequirements = {}
    local deckDepth = Config.HIGHWAY_DECK_THICKNESS_STUDS or 1.6
    for _, rec in ipairs(records) do
        for _, fractionAlong in ipairs({0.15, 0.35, 0.5, 0.65, 0.85}) do
            local point = rec.a:Lerp(rec.b, fractionAlong)
            local gy = terrainY(point.X, point.Z)
            if gy then
                local t = math.clamp(
                    (point.X*direction.X + point.Z*direction.Z-low)/span,0,1)
                if t > 0.025 and t < 0.975 then
                    local baseline = lerp(startGround,endGround,t)
                        + ROAD_OFFSET-rec.part.Size.Y/2-deckDepth
                    table.insert(terrainRequirements,{
                        t=t,needed=gy+1.0-baseline,
                    })
                end
            end
        end
    end
    targetLift = math.clamp(targetLift,nominalClearance,
        math.max(MAX_LIFT,nominalClearance))
    stats.crossingChecks += #crossings

    -- Smooth transition inside the tagged bridge region. Approach roads, when
    -- available, absorb much of the climb without touching city intersections.
    local fraction = math.clamp(Config.BRIDGE_RAMP_FRACTION or 0.38, 0.20, 0.49)

    -- Crossing clearance must be checked at the crossing's station, NOT only
    -- against the highest plateau. If it lies on a ramp, solve for the deck
    -- peak needed to clear that lower road at the actual intersection point.
    -- Never exceed MAX_LIFT; impossible crossings stay flagged by the audit.
    local allRequirements = {}
    for _, requirement in ipairs(crossings) do
        table.insert(allRequirements,requirement)
    end
    for _, requirement in ipairs(terrainRequirements) do
        table.insert(allRequirements,requirement)
    end
    for _, crossing in ipairs(allRequirements) do
        local t = crossing.t
        local ease = 1
        local terminalLift = 0
        if t < fraction then
            ease = smoothstep(t / fraction)
            terminalLift = startLift
        elseif t > 1 - fraction then
            ease = smoothstep((1 - t) / fraction)
            terminalLift = endLift
        end
        if ease > 0.001 then
            local requestedPeak = (crossing.needed
                - terminalLift * (1 - ease)) / ease
            targetLift = math.clamp(math.max(targetLift, requestedPeak),
                nominalClearance, math.max(MAX_LIFT, nominalClearance))
        end
    end
    -- HARD SLOPE CAP: a 25-stud county bridge can NOT gain 18 studs in
    -- its 9-stud transition section. Prior code warned but still GENERATED
    -- a 100%-300% rise. Respect capacity on BOTH approaches first.
    -- Smoothstep has a peak derivative of 1.5. Its allowed height change
    -- is therefore distance * MAX_GRADE / 1.5.
    local requestedLift = targetLift
    local innerCapacity = (span * fraction) * MAX_GRADE / 1.5
    local outerStartCapacity = startLength * MAX_GRADE / 1.5
    local outerEndCapacity = endLength * MAX_GRADE / 1.5
    local feasiblePeak = math.max(0, math.min(requestedLift,
        innerCapacity + outerStartCapacity,
        innerCapacity + outerEndCapacity))
    local noApproachClearance = requestedLift - feasiblePeak > 0.5
    targetLift = feasiblePeak
    startLift = math.min(targetLift, outerStartCapacity)
    endLift = math.min(targetLift, outerEndCapacity)
    if noApproachClearance then
        stats.insufficientApproachLength += 1
        stats.gradeLimitedParts += #parts
        for _, rec in ipairs(records) do
            rec.part:SetAttribute("CW_GradeLimited", true)
            rec.part:SetAttribute("CW_RequestedDeckLift", requestedLift)
            rec.part:SetAttribute("CW_AchievableDeckLift", targetLift)
        end
        if stats.insufficientApproachLength <= 12 then
            warn(("[ChesterWorld BridgeGradeLimited] name=%s group=%s x=%.1f z=%.1f span=%.1f requested=%.1f feasible=%.1f rampStart=%.1f rampEnd=%.1f"):format(
                bridgeName, groupKey,
                (lowPoint.X+highPoint.X)/2, (lowPoint.Z+highPoint.Z)/2,
                span, requestedLift, targetLift, startLength, endLength))
        end
    end

    local function liftAt(t)
        if t < fraction then
            return lerp(startLift, targetLift, smoothstep(t / fraction))
        elseif t > 1 - fraction then
            return lerp(endLift, targetLift,
                smoothstep((1 - t) / fraction))
        end
        return targetLift
    end
    local function centerY(t)
        return lerp(startGround, endGround, t) + ROAD_OFFSET + liftAt(t)
    end
    local function atXZ(x, z)
        local station = math.clamp((x * direction.X + z * direction.Z - low)
            / span, 0, 1)
        return centerY(station)
    end

    for _, rec in ipairs(records) do
        local t0 = math.clamp((rec.pa - low) / span, 0, 1)
        local t1 = math.clamp((rec.pb - low) / span, 0, 1)
        local a = Vector3.new(rec.a.X, centerY(t0), rec.a.Z)
        local b = Vector3.new(rec.b.X, centerY(t1), rec.b.Z)
        if setEndpoints(rec.part, a, b) then
            rec.part:SetAttribute("CW_TerrainConformed", true)
            rec.part:SetAttribute("CW_BridgeProfiled", true)
            rec.part:SetAttribute("CW_ElevationOwner", "RoadTerrainConformer:BridgeDeck")
            rec.part:SetAttribute("CW_DeckLiftCenter", liftAt((t0 + t1) / 2))
            stats.bridgeConformed += 1
        else
            stats.failed += 1
        end
    end

    -- Absolute roadway grade includes the REAL bare-earth baseline.
    -- Limiting only artificial lift doesn't make a naturally steep hillside
    -- driveable. Measure the fully rendered segment endpoints as well.
    local actualMaxGrade, segmentSteep = 0, 0
    for _, rec in ipairs(records) do
        local a, b = endpoints(rec.part)
        local horizontal = hdist(a, b)
        if horizontal > 0.1 then
            local grade = math.abs(a.Y-b.Y)/horizontal
            actualMaxGrade = math.max(actualMaxGrade, grade)
            if grade > MAX_GRADE * 1.15 then
                segmentSteep += 1
                rec.part:SetAttribute("CW_HighwayUnsafeGrade", true)
                rec.part:SetAttribute("CW_HighwayMaxGrade", grade)
                -- Skip structural dressing on places that still require
                -- terrain reconstruction / surveyed bridge endpoint levels.
                rec.part:SetAttribute("CW_GradeLimited", true)
            end
        end
    end
    if segmentSteep > 0 then
        stats.actualSteepParts += segmentSteep
        stats.baselineSteepGroups += 1
    end

    -- A bridge's tagged source span can be short. Report unsafe profiles rather
    -- than silently pretending the designed 10% ramp grade was achieved.
    local maxLeftGrade = 1.5 * math.abs(targetLift - startLift) / (span * fraction)
    local maxRightGrade = 1.5 * math.abs(targetLift - endLift) / (span * fraction)
    local worstGrade = math.max(maxLeftGrade,maxRightGrade)
    if worstGrade > 0.20 then
        stats.steepGroups += 1
        -- Report the physical impossibility instead of labeling a smooth
        -- interpolation as a safe highway ramp.
        if stats.steepGroups <= 12 then
            warn(("[ChesterWorld UnsafeBridgeProfile] name=%s group=%s x=%.1f z=%.1f span=%.1f studs maxGrade=%.1f%% rampStart=%.1f rampEnd=%.1f peakLift=%.1f"):format(
                bridgeName,groupKey,
                (lowPoint.X+highPoint.X)/2,(lowPoint.Z+highPoint.Z)/2,
                span,worstGrade*100,startLength,endLength,targetLift))
        end
        for _, rec in ipairs(records) do
            rec.part:SetAttribute("CW_HighwayUnsafeGrade",true)
            rec.part:SetAttribute("CW_HighwayMaxGrade",worstGrade)
        end
    end
    -- Track unresolved terrain and lower-road requirements distinctly.
    local terrainUnresolved = 0
    for _, requirement in ipairs(terrainRequirements) do
        if liftAt(requirement.t) + 0.25 < requirement.needed then
            terrainUnresolved += 1
        end
    end
    stats.terrainClearanceWarnings += terrainUnresolved
    for _, crossing in ipairs(crossings) do
        if liftAt(crossing.t) + 0.5 < crossing.needed then
            stats.clearanceWarnings += 1
        end
    end

    local sourceGroups = {}
    for _, part in ipairs(parts) do
        local originalGroup = attr(part, "CW_GradeGroup")
        if originalGroup ~= "" then sourceGroups[originalGroup] = true end
    end
    local profile = {
        group = groupKey, sourceGroups = sourceGroups, parts = parts,
        atXZ = atXZ, low = low, high = high,
        centerY = centerY, direction = direction,
        start = lowPoint, finish = highPoint,
    }
    table.insert(profilesByGroup, profile)

    -- Build ramp approaches only after the deck is positioned, and join their
    -- source endpoints exactly to the new bridge terminal heights.
    local function applyRamp(chain, totalLength, bridgeEnd, deckY)
        if #chain == 0 or totalLength < 0.1 then return end
        local nearRoad = chain[1].part
        local x, y = endpoints(nearRoad)
        local initialNear = hdist(x, bridgeEnd) < hdist(y, bridgeEnd) and x or y
        local lift = deckY - initialNear.Y
        -- Preserve at-grade city roads. Never lift arbitrary local approaches.
        local fade = math.max(totalLength, 0.1)
        local changed = 0
        for _, seg in ipairs(chain) do
            if rampUsed[seg.part] then break end
            local startPoint, endPoint = endpoints(seg.part)
            local near = hdist(startPoint, seg.near) <= hdist(endPoint, seg.near)
                and startPoint or endPoint
            local far = near == startPoint and endPoint or startPoint
            local d0 = math.min(seg.startDistance, fade)
            local d1 = math.min(seg.endDistance, fade)
            local lift0 = lift * (1 - smoothstep(d0 / fade))
            local lift1 = lift * (1 - smoothstep(d1 / fade))
            local na = Vector3.new(near.X, near.Y + lift0, near.Z)
            local nb = Vector3.new(far.X, far.Y + lift1, far.Z)
            if setEndpoints(seg.part, na, nb) then
                rampUsed[seg.part] = true
                seg.part:SetAttribute("CW_RampProfiled", true)
                seg.part:SetAttribute("CW_RampLiftCenter", (lift0 + lift1) / 2)
                seg.part:SetAttribute("CW_TerrainConformed", true)
                seg.part:SetAttribute("CW_ElevationOwner", "RoadTerrainConformer:HighwayRamp")
                rampsByGroup[attr(seg.part, "CW_GradeGroup")] =
                    rampsByGroup[attr(seg.part, "CW_GradeGroup")] or {}
                table.insert(rampsByGroup[attr(seg.part, "CW_GradeGroup")], seg.part)
                stats.rampParts += 1
                changed += 1
            end
        end
        if changed > 0 then
            stats.rampGroups += 1
            if math.abs(lift) * 1.5 / fade > MAX_GRADE * 1.2 then
                stats.steepGroups += 1
            end
        end
    end

    applyRamp(rampStart, startLength, lowPoint, centerY(0))
    applyRamp(rampEnd, endLength, highPoint, centerY(1))
    return profile
end

for key, group in pairs(corridorBridges) do
    stats.groups += 1
    stats.bridgeParts += #group
    for _, component in ipairs(components(group)) do
        stats.components += 1
        conformComponent(component, key)
        task.wait()
    end
end

-- Reposition yellow lane markings using the same grade group and X/Z deck
-- profile. They must never be left hovering at the old 18-stud proxy height.
local marksByGroup = {}
for _, marking in ipairs(allMarks) do
    local gradeGroup = attr(marking, "CW_GradeGroup")
    if gradeGroup ~= "" and attr(marking, "MarkingType") == "CenterLine" then
        marksByGroup[gradeGroup] = marksByGroup[gradeGroup] or {}
        table.insert(marksByGroup[gradeGroup], marking)
    end
end

local function profileDistance(profile, position)
    local nearest = math.huge
    for _, part in ipairs(profile.parts) do
        local a, b = endpoints(part)
        local segment = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
        local length2 = segment:Dot(segment)
        if length2 > 0.01 then
            local delta = Vector3.new(position.X-a.X, 0, position.Z-a.Z)
            local t = math.clamp(delta:Dot(segment) / length2, 0, 1)
            local p = a + (b-a)*t
            nearest = math.min(nearest, hdist(p, position))
        end
    end
    return nearest
end

for _, profile in ipairs(profilesByGroup) do
    local marks = {}
    for originalGroup in pairs(profile.sourceGroups) do
        for _, marking in ipairs(marksByGroup[originalGroup] or {}) do
            table.insert(marks, marking)
        end
    end
    for _, marking in ipairs(marks) do
        local a, b = endpoints(marking)
        local halfWidth = marking.Size.X
        if profileDistance(profile, marking.Position) <= math.max(halfWidth + 7, 15) then
            local offset = MARK_OFFSET - ROAD_OFFSET
            local ma = Vector3.new(a.X, profile.atXZ(a.X, a.Z) + offset, a.Z)
            local mb = Vector3.new(b.X, profile.atXZ(b.X, b.Z) + offset, b.Z)
            if setEndpoints(marking, ma, mb) then
                marking:SetAttribute("CW_ElevationOwner", "RoadTerrainConformer:BridgeMarking")
                stats.marked += 1
            end
        end
    end
end

-- Grade-0 motorway ramps can share a source group with other at-grade pieces.
-- Raise only markers whose actual road centerline belongs to a profiled ramp.
for groupKey, parts in pairs(rampsByGroup) do
    for _, marking in ipairs(marksByGroup[groupKey] or {}) do
        local a, b = endpoints(marking)
        local function markY(point)
            local best, bestDistance = nil, math.huge
            for _, road in ipairs(parts) do
                local x, y = endpoints(road)
                local d = Vector3.new(y.X-x.X,0,y.Z-x.Z)
                local d2 = d:Dot(d)
                if d2 > 0.01 then
                    local t = math.clamp(Vector3.new(point.X-x.X,0,point.Z-x.Z):Dot(d)/d2,0,1)
                    local nearest = x:Lerp(y,t)
                    local distance = hdist(nearest,point)
                    if distance < bestDistance then
                        bestDistance = distance
                        best = nearest.Y
                    end
                end
            end
            return bestDistance < 15 and best and best + (MARK_OFFSET-ROAD_OFFSET) or nil
        end
        local ya, yb = markY(a), markY(b)
        if ya and yb and setEndpoints(marking,
            Vector3.new(a.X, ya, a.Z), Vector3.new(b.X, yb, b.Z)) then
            marking:SetAttribute("CW_ElevationOwner", "RoadTerrainConformer:RampMarking")
            stats.marked += 1
        end
    end
end

local conformed = #atGrade - stats.rampParts + stats.rampParts
    + stats.bridgeConformed
Workspace:SetAttribute("CW_RoadConformTotal", #allRoads)
Workspace:SetAttribute("CW_RoadConformedCount", conformed)
Workspace:SetAttribute("CW_RoadConformComplete", true)

print(("[ChesterWorld RoadTerrainConformer] final=%d groundPreserved=%d bridgeConformed=%d conformed=%d noTerrain=%d failed=%d bridgeGroups=%d sourceBridgeGroups=%d bridgeComponents=%d bridgeParts=%d tunnelParts=%d rampParts=%d rampGroups=%d marked=%d crossingChecks=%d clearanceWarnings=%d terrainClearanceWarnings=%d terrainEndpointEstimates=%d steepGroups=%d gradeLimitedGroups=%d gradeLimitedParts=%d actualSteepParts=%d baselineSteepGroups=%d smoothDecks=true")
    :format(#allRoads, #atGrade-stats.rampParts, stats.bridgeConformed,
    conformed, stats.bridgeNoTerrain, stats.failed, stats.groups,
    sourceBridgeGroups, stats.components, stats.bridgeParts, stats.tunnelParts,
    stats.rampParts, stats.rampGroups, stats.marked, stats.crossingChecks,
    stats.clearanceWarnings, stats.terrainClearanceWarnings,
    stats.terrainEndpointEstimates,stats.steepGroups,
    stats.insufficientApproachLength,stats.gradeLimitedParts,
    stats.actualSteepParts,stats.baselineSteepGroups))
if stats.clearanceWarnings > 0 then
    warn(("[ChesterWorld Highway] %d bridge crossings need additional surveyed vertical data / ramp length to guarantee clearance."):format(stats.clearanceWarnings))
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1653">
            <Properties>
              <string name="Name">TileBuilder</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WorldConfig = require(Shared:WaitForChild("WorldConfig"))

local TileBuilder = {}

local S = WorldConfig.STUDS_PER_METER
local CENTER_X_M = WorldConfig.WORLD_CENTER_X_M
local CENTER_Z_M = WorldConfig.WORLD_CENTER_Z_M

local ROAD_YIELD_EVERY = 12
local BUILDING_YIELD_EVERY = 35
local INTERSECTION_YIELD_EVERY = 60

local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.FilterDescendantsInstances = { workspace.Terrain }
terrainParams.IgnoreWater = false

-- LOCKED CHESTERWORLD ROBLOX HANDEDNESS:
-- +X = east
-- -Z = north
local function sourceToStuds(xMeters, zMeters)
	return
		(xMeters - CENTER_X_M) * S,
		-(zMeters - CENTER_Z_M) * S
end

local function terrainY(xStuds, zStuds)
	local hit = workspace:Raycast(
		Vector3.new(xStuds, 5000, zStuds),
		Vector3.new(0, -10000, 0),
		terrainParams
	)

	if hit then
		return hit.Position.Y
	end

	return nil
end

local function makeFolder(parent, name)
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing
	end

	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function horizontalLength(a, b)
	local dx = b.X - a.X
	local dz = b.Z - a.Z
	return math.sqrt(dx * dx + dz * dz)
end

local function horizontalPerpendicular(a, b)
	local dx = b.X - a.X
	local dz = b.Z - a.Z
	local length = math.sqrt(dx * dx + dz * dz)

	if length < 0.001 then
		return Vector3.new(1, 0, 0)
	end

	return Vector3.new(-dz / length, 0, dx / length)
end

local function safeGroundPair(x1, z1, x2, z2, offset)
	local y1 = terrainY(x1, z1)
	local y2 = terrainY(x2, z2)

	if y1 == nil and y2 == nil then
		return nil, nil
	end

	if y1 == nil then
		y1 = y2
	elseif y2 == nil then
		y2 = y1
	end

	local a = Vector3.new(x1, y1 + offset, z1)
	local b = Vector3.new(x2, y2 + offset, z2)

	local run = horizontalLength(a, b)
	if run < 0.05 then
		return nil, nil
	end

	local grade = math.abs(b.Y - a.Y) / run
	if grade > WorldConfig.MAX_SURFACE_GRADE then
		return nil, nil
	end

	return a, b
end

local function colorForParent(parent)
	if parent.Name == "Roads" then
		return WorldConfig.ROAD_COLOR
	elseif parent.Name == "Sidewalks" then
		return WorldConfig.SIDEWALK_COLOR
	elseif parent.Name == "RoadMarkings" then
		return WorldConfig.CROSSWALK_COLOR
	end

	return nil
end

local function makeStripPart(
	parent,
	name,
	a,
	b,
	width,
	thickness,
	material,
	color
)
	if not a or not b then
		return nil
	end

	local delta = b - a
	local length = delta.Magnitude

	if length < 0.05 then
		return nil
	end

	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = parent.Name ~= "RoadMarkings"
	part.CanTouch = parent.Name ~= "RoadMarkings"
	part.CanQuery = true
	part.CastShadow = parent.Name ~= "RoadMarkings"
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = Vector3.new(width, thickness, length)
	part.CFrame = CFrame.lookAt((a + b) / 2, b, Vector3.yAxis)

	local finalColor = color or colorForParent(parent)
	if finalColor then
		part.Color = finalColor
	end

	part.Parent = parent
	return part
end

local function endpointKeyFromStuds(x, z)
	local q = WorldConfig.INTERSECTION_ENDPOINT_QUANTIZE_STUDS
	return
		tostring(math.floor(x / q + 0.5))
		.. ":"
		.. tostring(math.floor(z / q + 0.5))
end

local function endpointKeyFromMeters(xMeters, zMeters)
	local x, z = sourceToStuds(xMeters, zMeters)
	return endpointKeyFromStuds(x, z)
end

local function collectIntersectionNodes(roads)
	local nodes = {}

	local function addEndpoint(
		xMeters,
		zMeters,
		otherXMeters,
		otherZMeters,
		road
	)
		local x, z = sourceToStuds(xMeters, zMeters)
		local ox, oz = sourceToStuds(otherXMeters, otherZMeters)
		local key = endpointKeyFromStuds(x, z)

		local node = nodes[key]
		if not node then
			node = {
				xSum = 0,
				zSum = 0,
				count = 0,
				maxWidth = 0,
				names = {},
				arms = {},
				distinctNames = 0,
				isIntersection = false,
				isNamedIntersection = false,
			}
			nodes[key] = node
		end

		local roadWidth = math.max((road.width_m or 7) * S, 3)

		node.xSum += x
		node.zSum += z
		node.count += 1
		node.maxWidth = math.max(node.maxWidth, roadWidth)

		local name = tostring(road.name or "")
		if name ~= "" and name ~= "Road" then
			node.names[name] = true
		end

		local dx = ox - x
		local dz = oz - z
		local length = math.sqrt(dx * dx + dz * dz)

		if length > 0.001 then
			table.insert(node.arms, {
				name = name,
				width = roadWidth,
				dir = Vector3.new(dx / length, 0, dz / length),
			})
		end
	end

	for index, road in ipairs(roads or {}) do
		addEndpoint(
			road.x1, road.z1,
			road.x2, road.z2,
			road
		)
		addEndpoint(
			road.x2, road.z2,
			road.x1, road.z1,
			road
		)

		if index % 80 == 0 then
			task.wait()
		end
	end

	for _, node in pairs(nodes) do
		local distinctNames = 0
		for _ in pairs(node.names) do
			distinctNames += 1
		end

		node.distinctNames = distinctNames
		node.isNamedIntersection = distinctNames >= 2
		node.isIntersection =
			node.count >= WorldConfig.INTERSECTION_MIN_DEGREE
			or node.isNamedIntersection
	end

	return nodes
end

local function pointAlong2D(a, b, distanceFromA)
	local dx = b.X - a.X
	local dz = b.Z - a.Z
	local length = math.sqrt(dx * dx + dz * dz)

	if length < 0.001 then
		return a
	end

	local t = math.clamp(distanceFromA / length, 0, 1)
	return Vector3.new(
		a.X + dx * t,
		0,
		a.Z + dz * t
	)
end

local function trimmedCenterlineEndpoints(road, intersectionNodes, roadWidth)
	local x1, z1 = sourceToStuds(road.x1, road.z1)
	local x2, z2 = sourceToStuds(road.x2, road.z2)

	local a = Vector3.new(x1, 0, z1)
	local b = Vector3.new(x2, 0, z2)

	local length = horizontalLength(a, b)
	if length < 0.05 then
		return nil, nil
	end

	local startNode =
		intersectionNodes[endpointKeyFromMeters(road.x1, road.z1)]
	local endNode =
		intersectionNodes[endpointKeyFromMeters(road.x2, road.z2)]

	local trim = math.max(
		WorldConfig.SIDEWALK_INTERSECTION_TRIM_STUDS,
		roadWidth * 0.65
	)

	local trimStart =
		(startNode and startNode.isIntersection) and trim or 0
	local trimEnd =
		(endNode and endNode.isIntersection) and trim or 0

	if trimStart + trimEnd >= length - 2 then
		return nil, nil
	end

	local ta = pointAlong2D(a, b, trimStart)
	local tb = pointAlong2D(b, a, trimEnd)

	return ta, tb
end

local function shouldSplit(a, b, depth, surfaceOffset)
	if depth >= WorldConfig.ROAD_MAX_SUBDIVISION_DEPTH then
		return false
	end

	if horizontalLength(a, b)
		> WorldConfig.ROAD_MAX_PIECE_LENGTH_STUDS
	then
		return true
	end

	local midX = (a.X + b.X) / 2
	local midZ = (a.Z + b.Z) / 2
	local groundMid = terrainY(midX, midZ)

	if groundMid == nil then
		return false
	end

	local terrainMidY = groundMid + surfaceOffset
	local linearMidY = (a.Y + b.Y) / 2

	return
		math.abs(terrainMidY - linearMidY)
		> WorldConfig.ROAD_TERRAIN_ERROR_STUDS
end

local function buildAdaptiveCenterStrip(
	parent,
	name,
	x1,
	z1,
	x2,
	z2,
	width,
	thickness,
	material,
	color,
	offset,
	depth,
	attributes
)
	depth = depth or 0

	local a, b = safeGroundPair(x1, z1, x2, z2, offset)
	if not a or not b then
		return
	end

	if shouldSplit(a, b, depth, offset) then
		local midX = (x1 + x2) / 2
		local midZ = (z1 + z2) / 2

		buildAdaptiveCenterStrip(
			parent, name,
			x1, z1, midX, midZ,
			width, thickness, material, color, offset,
			depth + 1, attributes
		)

		buildAdaptiveCenterStrip(
			parent, name,
			midX, midZ, x2, z2,
			width, thickness, material, color, offset,
			depth + 1, attributes
		)

		return
	end

	local part = makeStripPart(
		parent,
		name,
		a,
		b,
		width,
		thickness,
		material,
		color
	)

	if part and attributes then
		for key, value in pairs(attributes) do
			part:SetAttribute(key, value)
		end
	end
end

local function buildSidewalkPair(
	sidewalksFolder,
	streetName,
	a2D,
	b2D,
	roadWidth
)
	if not a2D or not b2D then
		return
	end

	local perpendicular = horizontalPerpendicular(a2D, b2D)
	local sidewalkWidth = WorldConfig.SIDEWALK_WIDTH_STUDS

	local offsetDistance =
		(roadWidth / 2)
		+ WorldConfig.SIDEWALK_GAP_STUDS
		+ (sidewalkWidth / 2)

	local sidewalkSurfaceOffset =
		WorldConfig.SIDEWALK_HEIGHT_STUDS / 2
		+ 0.15

	for _, sign in ipairs({ -1, 1 }) do
		local offset = perpendicular * offsetDistance * sign

		buildAdaptiveCenterStrip(
			sidewalksFolder,
			"Sidewalk",
			a2D.X + offset.X,
			a2D.Z + offset.Z,
			b2D.X + offset.X,
			b2D.Z + offset.Z,
			sidewalkWidth,
			WorldConfig.SIDEWALK_HEIGHT_STUDS,
			WorldConfig.SIDEWALK_MATERIAL,
			WorldConfig.SIDEWALK_COLOR,
			sidewalkSurfaceOffset,
			0,
			{
				ChesterStreet = streetName,
				Side = sign < 0 and "Left" or "Right",
			}
		)
	end
end

local function buildCenterLine(
	markingsFolder,
	road,
	intersectionNodes,
	roadWidth
)
	if roadWidth < WorldConfig.CENTERLINE_MIN_ROAD_WIDTH_STUDS then
		return
	end

	local streetName = tostring(road.name or "")
	if streetName == "" or streetName == "Road" then
		return
	end

	local a2D, b2D =
		trimmedCenterlineEndpoints(
			road,
			intersectionNodes,
			roadWidth
		)

	if not a2D or not b2D then
		return
	end

	buildAdaptiveCenterStrip(
		markingsFolder,
		"CenterLine",
		a2D.X, a2D.Z,
		b2D.X, b2D.Z,
		WorldConfig.CENTERLINE_WIDTH_STUDS,
		WorldConfig.CENTERLINE_THICKNESS_STUDS,
		WorldConfig.MARKING_MATERIAL,
		WorldConfig.CENTERLINE_COLOR,
		WorldConfig.CENTERLINE_SURFACE_OFFSET_STUDS,
		0,
		{
			ChesterStreet = streetName,
			MarkingType = "CenterLine",
		}
	)
end

local function buildRoad(
	roadsFolder,
	sidewalksFolder,
	markingsFolder,
	road,
	intersectionNodes
)
	local x1, z1 = sourceToStuds(road.x1, road.z1)
	local x2, z2 = sourceToStuds(road.x2, road.z2)

	local roadWidth = math.max((road.width_m or 7) * S, 3)
	local streetName = tostring(road.name or "")

	buildAdaptiveCenterStrip(
		roadsFolder,
		streetName ~= "" and streetName or "Road",
		x1, z1, x2, z2,
		roadWidth,
		WorldConfig.ROAD_THICKNESS_STUDS,
		WorldConfig.ROAD_MATERIAL,
		WorldConfig.ROAD_COLOR,
		WorldConfig.ROAD_SURFACE_OFFSET_STUDS,
		0,
		{
			ChesterStreet = streetName,
			RoadWidthStuds = roadWidth,
		}
	)

	if streetName ~= "" and streetName ~= "Road" then
		local sidewalkA, sidewalkB =
			trimmedCenterlineEndpoints(
				road,
				intersectionNodes,
				roadWidth
			)

		buildSidewalkPair(
			sidewalksFolder,
			streetName,
			sidewalkA,
			sidewalkB,
			roadWidth
		)
	end

	buildCenterLine(
		markingsFolder,
		road,
		intersectionNodes,
		roadWidth
	)
end

local function uniqueIntersectionNames(node)
	local labels = {}
	for name in pairs(node.names) do
		table.insert(labels, name)
	end
	table.sort(labels)
	return labels
end

local function buildCrosswalkForArm(
	markingsFolder,
	node,
	arm
)
	if arm.width < WorldConfig.CROSSWALK_MIN_ARM_WIDTH_STUDS then
		return
	end

	local dir = arm.dir
	if dir.Magnitude < 0.001 then
		return
	end

	local x = node.xSum / node.count
	local z = node.zSum / node.count
	local perpendicular = Vector3.new(-dir.Z, 0, dir.X)

	local baseSetback = math.max(
		WorldConfig.CROSSWALK_BASE_SETBACK_STUDS,
		node.maxWidth * 0.56
	)

	local usableWidth = math.max(arm.width - 2.0, 4.0)
	local halfAcross = usableWidth / 2

	for stripe = 0, WorldConfig.CROSSWALK_STRIPE_COUNT - 1 do
		local along =
			baseSetback
			+ stripe
				* (
					WorldConfig.CROSSWALK_STRIPE_DEPTH_STUDS
					+ WorldConfig.CROSSWALK_STRIPE_GAP_STUDS
				)

		local center =
			Vector3.new(x, 0, z)
			+ dir * along

		local p1 = center - perpendicular * halfAcross
		local p2 = center + perpendicular * halfAcross

		local a, b = safeGroundPair(
			p1.X, p1.Z,
			p2.X, p2.Z,
			WorldConfig.CROSSWALK_SURFACE_OFFSET_STUDS
		)

		local stripePart = makeStripPart(
			markingsFolder,
			"Crosswalk",
			a,
			b,
			WorldConfig.CROSSWALK_STRIPE_DEPTH_STUDS,
			WorldConfig.CROSSWALK_THICKNESS_STUDS,
			WorldConfig.MARKING_MATERIAL,
			WorldConfig.CROSSWALK_COLOR
		)

		if stripePart then
			stripePart:SetAttribute("MarkingType", "Crosswalk")
			stripePart:SetAttribute(
				"ChesterStreet",
				tostring(arm.name or "")
			)
		end
	end
end

local function bestPerpendicularArmPair(node)
	local bestA = nil
	local bestB = nil
	local bestScore = math.huge

	for i = 1, #node.arms do
		local a = node.arms[i]
		if a.name ~= "" and a.name ~= "Road" then
			for j = i + 1, #node.arms do
				local b = node.arms[j]

				if
					b.name ~= ""
					and b.name ~= "Road"
					and b.name ~= a.name
				then
					local score = math.abs(a.dir:Dot(b.dir))
					if score < bestScore then
						bestScore = score
						bestA = a
						bestB = b
					end
				end
			end
		end
	end

	return bestA, bestB
end

local function buildStreetSign(signsFolder, node, labels)
	if
		not node.isNamedIntersection
		or node.maxWidth < WorldConfig.STREET_SIGN_TRIGGER_WIDTH_STUDS
		or #labels < 2
	then
		return
	end

	local armA, armB = bestPerpendicularArmPair(node)
	if not armA or not armB then
		return
	end

	local cornerDir = armA.dir + armB.dir
	if cornerDir.Magnitude < 0.001 then
		cornerDir = Vector3.new(1, 0, 1)
	end
	cornerDir = cornerDir.Unit

	local x = node.xSum / node.count
	local z = node.zSum / node.count
	local distance =
		node.maxWidth * 0.62
		+ WorldConfig.STREET_SIGN_CORNER_CLEARANCE_STUDS

	local signX = x + cornerDir.X * distance
	local signZ = z + cornerDir.Z * distance
	local ground = terrainY(signX, signZ)

	if ground == nil then
		return
	end

	local poleHeight = WorldConfig.STREET_SIGN_POLE_HEIGHT_STUDS

	local pole = Instance.new("Part")
	pole.Name = "StreetSign"
	pole.Anchored = true
	pole.CanCollide = false
	pole.Material = WorldConfig.SIGN_POLE_MATERIAL
	pole.Color = WorldConfig.SIGN_POLE_COLOR
	pole.Size = Vector3.new(
		WorldConfig.STREET_SIGN_POLE_THICKNESS_STUDS,
		poleHeight,
		WorldConfig.STREET_SIGN_POLE_THICKNESS_STUDS
	)
	pole.Position = Vector3.new(
		signX,
		ground + poleHeight / 2,
		signZ
	)
	pole.Parent = signsFolder

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "StreetNames"
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 360
	billboard.Size = UDim2.fromOffset(190, 48)
	billboard.StudsOffset = Vector3.new(
		0,
		poleHeight / 2 + 2.5,
		0
	)
	billboard.Parent = pole

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = WorldConfig.SIGN_BACKGROUND_COLOR
	label.BackgroundTransparency = 0.03
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = WorldConfig.SIGN_TEXT_COLOR
	label.TextSize = 15
	label.TextWrapped = true
	label.Text = string.upper(labels[1] .. " / " .. labels[2])
	label.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = label

	pole:SetAttribute(
		"Intersection",
		labels[1] .. " & " .. labels[2]
	)
end

local function buildIntersections(
	parent,
	markingsFolder,
	signsFolder,
	nodes
)
	local processed = 0

	for _, node in pairs(nodes) do
		processed += 1

		if node.isIntersection then
			local x = node.xSum / node.count
			local z = node.zSum / node.count
			local y = terrainY(x, z)

			if y ~= nil then
				local size = math.max(
					node.maxWidth
						* WorldConfig.INTERSECTION_SIZE_MULTIPLIER,
					12
				)

				local pad = Instance.new("Part")
				pad.Name = "Intersection"
				pad.Anchored = true
				pad.CanCollide = true
				pad.Material = WorldConfig.INTERSECTION_MATERIAL
				pad.Color = WorldConfig.INTERSECTION_COLOR
				pad.TopSurface = Enum.SurfaceType.Smooth
				pad.BottomSurface = Enum.SurfaceType.Smooth
				pad.Size = Vector3.new(
					size,
					WorldConfig.ROAD_THICKNESS_STUDS + 0.05,
					size
				)
				pad.CFrame = CFrame.new(
					x,
					y + WorldConfig.ROAD_SURFACE_OFFSET_STUDS,
					z
				)
				pad.Parent = parent

				local labels = uniqueIntersectionNames(node)

				if #labels > 0 then
					pad:SetAttribute(
						"Intersection",
						table.concat(labels, " & ")
					)
				end

				if
					node.isNamedIntersection
					and node.maxWidth
						>= WorldConfig.CROSSWALK_TRIGGER_WIDTH_STUDS
				then
					for _, arm in ipairs(node.arms) do
						buildCrosswalkForArm(
							markingsFolder,
							node,
							arm
						)
					end
				end

				buildStreetSign(
					signsFolder,
					node,
					labels
				)
			end
		end

		if processed % INTERSECTION_YIELD_EVERY == 0 then
			task.wait()
		end
	end
end

local function buildBuilding(parent, building)
	local heightStuds =
		math.max((building.height_m or 9.15) * S, 2)
	local widthStuds =
		math.max((building.width_m or 5) * S, 1)
	local depthStuds =
		math.max((building.depth_m or 8) * S, 1)

	local x, z = sourceToStuds(building.x_m, building.z_m)
	local groundY = terrainY(x, z)

	if groundY == nil then
		return
	end

	local y =
		groundY
		+ WorldConfig.BUILDING_BASE_Y_STUDS
		+ (heightStuds / 2)

	local part = Instance.new("Part")
	part.Name = building.name or building.id or "Building"
	part.Anchored = true
	part.CanCollide = true
	part.Material = WorldConfig.BUILDING_MATERIAL
	part.Size = Vector3.new(
		widthStuds,
		heightStuds,
		depthStuds
	)

	-- Mirrored yaw matches north=-Z Roblox handedness.
	part.CFrame =
		CFrame.new(x, y, z)
		* CFrame.Angles(
			0,
			math.rad(building.yaw_deg or 0),
			0
		)

	part.Parent = parent

	part:SetAttribute(
		"ChesterBuildingId",
		tostring(building.id or "")
	)
	part:SetAttribute(
		"SourceHeightMeters",
		building.height_m or 9.15
	)
	part:SetAttribute("GroundY", groundY)
end

function TileBuilder.Build(tileModule)
	local tile = require(tileModule)

	local workspaceRoot =
		workspace:FindFirstChild("ChesterWorld")

	if not workspaceRoot then
		workspaceRoot = makeFolder(
			workspace,
			"ChesterWorld"
		)
	end

	local tileFolder = makeFolder(
		workspaceRoot,
		tile.tile_id or tileModule.Name
	)
	tileFolder:SetAttribute(
		"TileId",
		tile.tile_id or tileModule.Name
	)

	local roadsFolder =
		makeFolder(tileFolder, "Roads")
	local sidewalksFolder =
		makeFolder(tileFolder, "Sidewalks")
	local intersectionsFolder =
		makeFolder(tileFolder, "Intersections")
	local markingsFolder =
		makeFolder(tileFolder, "RoadMarkings")
	local signsFolder =
		makeFolder(tileFolder, "StreetSigns")
	local buildingsFolder =
		makeFolder(tileFolder, "Buildings")

	local intersectionNodes =
		collectIntersectionNodes(tile.roads or {})

	task.wait()

	for index, road in ipairs(tile.roads or {}) do
		buildRoad(
			roadsFolder,
			sidewalksFolder,
			markingsFolder,
			road,
			intersectionNodes
		)

		if index % ROAD_YIELD_EVERY == 0 then
			task.wait()
		end
	end

	task.wait()

	buildIntersections(
		intersectionsFolder,
		markingsFolder,
		signsFolder,
		intersectionNodes
	)

	task.wait()

	for index, building in ipairs(tile.buildings or {}) do
		buildBuilding(
			buildingsFolder,
			building
		)

		if index % BUILDING_YIELD_EVERY == 0 then
			task.wait()
		end
	end

	return tileFolder
end

return TileBuilder
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1654">
            <Properties>
              <string name="Name">TileBuilderV2</string>
              <string name="Source"><![CDATA[local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WorldConfig = require(Shared:WaitForChild("WorldConfig"))

local TileBuilderV2 = {}

local S = WorldConfig.STUDS_PER_METER
local CENTER_X_M = WorldConfig.WORLD_CENTER_X_M
local CENTER_Z_M = WorldConfig.WORLD_CENTER_Z_M

local ROAD_YIELD_EVERY = 20
local BUILDING_YIELD_EVERY = 40
local INTERSECTION_YIELD_EVERY = 40

local POLYGON_CORE_MIN = 3.5
local POLYGON_CORE_MAX = 9.0
local POLYGON_MOUTH_MIN = 6.0
local POLYGON_MOUTH_MAX = 38.0
local POLYGON_MOUTH_OVERLAP = 1.25
local POLYGON_LATERAL_OVERLAP = 0.75

local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.FilterDescendantsInstances = { workspace.Terrain }
terrainParams.IgnoreWater = false

local prepared = false
local globalIntersectionNodes = {}
local globalJunctionGroups = {}
local proximityGrid = {}
local PROXIMITY_CELL_STUDS = 160

local function proximityCell(x, z)
    return math.floor(x / PROXIMITY_CELL_STUDS), math.floor(z / PROXIMITY_CELL_STUDS)
end
local function proximityKey(x, z)
    local gx, gz = proximityCell(x, z)
    return tostring(gx) .. ":" .. tostring(gz)
end

-- LOCKED CHESTERWORLD HANDEDNESS:
-- +X = east, -Z = north.
local function sourceToStuds(xMeters, zMeters)
	return
		(xMeters - CENTER_X_M) * S,
		-(zMeters - CENTER_Z_M) * S
end

local function terrainY(xStuds, zStuds)
	local hit = workspace:Raycast(
		Vector3.new(xStuds, 5000, zStuds),
		Vector3.new(0, -10000, 0),
		terrainParams
	)
	return hit and hit.Position.Y or nil
end

local function makeFolder(parent, name)
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:ClearAllChildren()
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function horizontalLength(a, b)
	local dx = b.X - a.X
	local dz = b.Z - a.Z
	return math.sqrt(dx * dx + dz * dz)
end

local function horizontalPerpendicular(a, b)
	local dx = b.X - a.X
	local dz = b.Z - a.Z
	local length = math.sqrt(dx * dx + dz * dz)
	if length < 0.001 then
		return Vector3.new(1, 0, 0)
	end
	return Vector3.new(-dz / length, 0, dx / length)
end

local function truthy(value)
	if value == true then
		return true
	end
	local text = string.lower(tostring(value or ""))
	return text ~= ""
		and text ~= "0"
		and text ~= "false"
		and text ~= "no"
		and text ~= "none"
		and text ~= "nil"
end

local function gradeLevelForRoad(road)
	local level = tonumber(road.layer) or 0
	if truthy(road.bridge) and level <= 0 then
		level = 1
	elseif truthy(road.tunnel) and level >= 0 then
		level = -1
	end
	return math.clamp(math.round(level), -5, 5)
end

local function gradeOffsetForRoad(road)
	local level = gradeLevelForRoad(road)
	if level > 0 then
		return level * WorldConfig.GRADE_SEPARATION_CLEARANCE_STUDS
	end
	return 0
end

local function roadClass(road)
	return string.lower(tostring(road.road_class or ""))
end

local function shouldBuildSidewalk(road)
	if truthy(road.bridge) or truthy(road.tunnel) then
		return false
	end
	local cls = roadClass(road)
	return cls ~= "motorway"
		and cls ~= "motorway_link"
		and cls ~= "trunk"
		and cls ~= "trunk_link"
		and cls ~= "service"
		and cls ~= "alley"
end

local function safeGroundPair(x1, z1, x2, z2, surfaceOffset, gradeOffset)
	local y1 = terrainY(x1, z1)
	local y2 = terrainY(x2, z2)
	if y1 == nil and y2 == nil then
		return nil, nil
	end
	if y1 == nil then
		y1 = y2
	elseif y2 == nil then
		y2 = y1
	end
	local totalOffset = surfaceOffset + (gradeOffset or 0)
	local a = Vector3.new(x1, y1 + totalOffset, z1)
	local b = Vector3.new(x2, y2 + totalOffset, z2)
	local run = horizontalLength(a, b)
	if run < 0.05 then
		return nil, nil
	end
	if (gradeOffset or 0) == 0 then
		local grade = math.abs(b.Y - a.Y) / run
		if grade > WorldConfig.MAX_SURFACE_GRADE then
			return nil, nil
		end
	end
	return a, b
end

local function colorForParent(parent)
	if parent.Name == "Roads" then
		return WorldConfig.ROAD_COLOR
	elseif parent.Name == "Sidewalks" then
		return WorldConfig.SIDEWALK_COLOR
	elseif parent.Name == "RoadMarkings" then
		return WorldConfig.CROSSWALK_COLOR
	end
	return nil
end

local function makeStripPart(parent, name, a, b, width, thickness, material, color)
	if not a or not b then
		return nil
	end
	local delta = b - a
	local length = delta.Magnitude
	if length < 0.05 then
		return nil
	end
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = parent.Name ~= "RoadMarkings"
	part.CanTouch = parent.Name ~= "RoadMarkings"
	part.CanQuery = true
	part.CastShadow = parent.Name ~= "RoadMarkings"
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = Vector3.new(width, thickness, length)
	part.CFrame = CFrame.lookAt((a + b) / 2, b, Vector3.yAxis)
	local finalColor = color or colorForParent(parent)
	if finalColor then
		part.Color = finalColor
	end
	part.Parent = parent
	return part
end

local function endpointKeyFromStuds(x, z, gradeLevel, connectionGroup)
	local q = WorldConfig.INTERSECTION_ENDPOINT_QUANTIZE_STUDS
	local key = tostring(math.floor(x / q + 0.5))
		.. ":" .. tostring(math.floor(z / q + 0.5))
		.. ":g" .. tostring(gradeLevel or 0)
	-- A source crossing may share X/Z and numeric layer without being a
	-- routable junction. The optional group separates only that endpoint;
	-- it does not change the road's vertical position.
	if connectionGroup and connectionGroup ~= "" then
		return key .. ":c" .. tostring(connectionGroup)
	end
	return key
end

local function endpointConnectionGroup(road, endpointIndex)
	if endpointIndex == 1 then
		return road.node1_connection_group
	end
	return road.node2_connection_group
end

local function endpointKeyFromMeters(xMeters, zMeters, road, endpointIndex)
	local x, z = sourceToStuds(xMeters, zMeters)
	return endpointKeyFromStuds(x, z, gradeLevelForRoad(road), endpointConnectionGroup(road, endpointIndex))
end

local function armKey(name, dir)
	local qx = math.floor(dir.X * 20 + (dir.X >= 0 and 0.5 or -0.5))
	local qz = math.floor(dir.Z * 20 + (dir.Z >= 0 and 0.5 or -0.5))
	return string.upper(name) .. ":" .. tostring(qx) .. ":" .. tostring(qz)
end

local function cross2(a, b, c)
	return (b.X - a.X) * (c.Y - a.Y) - (b.Y - a.Y) * (c.X - a.X)
end

local function convexHull(points)
	if #points < 3 then
		return points
	end
	local unique = {}
	local seen = {}
	for _, p in ipairs(points) do
		local key = tostring(math.floor(p.X * 100 + 0.5)) .. ":" .. tostring(math.floor(p.Y * 100 + 0.5))
		if not seen[key] then
			seen[key] = true
			table.insert(unique, p)
		end
	end
	if #unique < 3 then
		return unique
	end
	table.sort(unique, function(a, b)
		if a.X == b.X then
			return a.Y < b.Y
		end
		return a.X < b.X
	end)
	local lower = {}
	for _, p in ipairs(unique) do
		while #lower >= 2 and cross2(lower[#lower - 1], lower[#lower], p) <= 0 do
			table.remove(lower)
		end
		table.insert(lower, p)
	end
	local upper = {}
	for i = #unique, 1, -1 do
		local p = unique[i]
		while #upper >= 2 and cross2(upper[#upper - 1], upper[#upper], p) <= 0 do
			table.remove(upper)
		end
		table.insert(upper, p)
	end
	table.remove(lower)
	table.remove(upper)
	for _, p in ipairs(upper) do
		table.insert(lower, p)
	end
	return lower
end

local function polygonFromNode(node)
	local points = {}
	local center = Vector3.new(node.x, 0, node.z)
	local coreRadius = math.clamp(node.maxWidth * 0.28, POLYGON_CORE_MIN, POLYGON_CORE_MAX)
	for i = 0, 7 do
		local angle = math.rad(i * 45)
		table.insert(points, Vector2.new(
			node.x + math.cos(angle) * coreRadius,
			node.z + math.sin(angle) * coreRadius
		))
	end
	local baseMouthDistance = math.clamp(
		node.maxWidth * 0.58,
		POLYGON_MOUTH_MIN,
		POLYGON_MOUTH_MAX
	)
	for _, arm in ipairs(node.arms) do
		local dir = arm.dir
		local perp = Vector3.new(-dir.Z, 0, dir.X)
		local mouthDistance = math.max(baseMouthDistance, arm.width * 0.55) + POLYGON_MOUTH_OVERLAP
		local halfWidth = arm.width / 2 + POLYGON_LATERAL_OVERLAP
		local mouth = center + dir * mouthDistance
		table.insert(points, Vector2.new(mouth.X + perp.X * halfWidth, mouth.Z + perp.Z * halfWidth))
		table.insert(points, Vector2.new(mouth.X - perp.X * halfWidth, mouth.Z - perp.Z * halfWidth))
	end
	return convexHull(points)
end

-- Query the EXACT convex paving polygon at any lateral offset.
-- Used for both full-width road mouths and correctly set-back zebra crossings.
local function rayPolygonExitAtOffset(node, dir, offset)
    local polygon = node.polygon
    if not polygon or #polygon < 3 then return nil end
    local perpendicular = Vector3.new(-dir.Z, 0, dir.X)
    local px = node.x + perpendicular.X * offset
    local pz = node.z + perpendicular.Z * offset
    local rx, rz = dir.X, dir.Z
    local farthest = nil
    for i = 1, #polygon do
        local a = polygon[i]
        local b = polygon[(i % #polygon) + 1]
        local sx, sz = b.X - a.X, b.Y - a.Y
        local denom = rx * sz - rz * sx
        if math.abs(denom) > 1e-7 then
            local qx, qz = a.X - px, a.Y - pz
            local t = (qx * sz - qz * sx) / denom
            local u = (qx * rz - qz * rx) / denom
            if t >= 0 and u >= -1e-5 and u <= 1 + 1e-5 then
                if not farthest or t > farthest then farthest = t end
            end
        end
    end
    return farthest
end

local function polygonArmBoundary(node, dir, halfWidth, useFarthest)
    local middle = rayPolygonExitAtOffset(node, dir, 0)
    if not middle then return node.maxWidth * 0.55 end
    if not halfWidth or halfWidth < 0.1 then return middle end
    local left = rayPolygonExitAtOffset(node, dir, -halfWidth) or middle
    local right = rayPolygonExitAtOffset(node, dir, halfWidth) or middle
    if useFarthest then
        return math.max(middle, left, right)
    end
    -- For the pavement approach, the nearest polygon edge determines where
    -- a full-width rectangular road can begin without leaving a dirt wedge.
    return math.min(middle, left, right)
end

local function rayPolygonDistance(node, dir)
	local polygon = node.polygon
	if not polygon or #polygon < 3 then
		return 0
	end
	local px = node.x
	local pz = node.z
	local rx = dir.X
	local rz = dir.Z
	local best = math.huge
	for i = 1, #polygon do
		local a = polygon[i]
		local b = polygon[(i % #polygon) + 1]
		local sx = b.X - a.X
		local sz = b.Y - a.Y
		local denom = rx * sz - rz * sx
		if math.abs(denom) > 1e-7 then
			local qx = a.X - px
			local qz = a.Y - pz
			local t = (qx * sz - qz * sx) / denom
			local u = (qx * rz - qz * rx) / denom
			if t >= 0 and u >= -1e-5 and u <= 1 + 1e-5 and t < best then
				best = t
			end
		end
	end
	if best == math.huge then
		return node.maxWidth * 0.55
	end
	return best
end

local function addEndpoint(nodes, tileId, xMeters, zMeters, otherXMeters, otherZMeters, road, endpointIndex)
	local x, z = sourceToStuds(xMeters, zMeters)
	local ox, oz = sourceToStuds(otherXMeters, otherZMeters)
	local gradeLevel = gradeLevelForRoad(road)
	local key = endpointKeyFromStuds(x, z, gradeLevel, endpointConnectionGroup(road, endpointIndex))
	local node = nodes[key]
	if not node then
		node = {
			xSum = 0,
			zSum = 0,
			count = 0,
			maxWidth = 0,
			names = {},
			rawArms = {},
            links = {},
			arms = {},
			polygon = nil,
			distinctNames = 0,
			isIntersection = false,
			isNamedIntersection = false,
			gradeLevel = gradeLevel,
			ownerTile = tileId,
		}
		nodes[key] = node
	elseif tileId < node.ownerTile then
		node.ownerTile = tileId
	end
	local roadWidth = math.max((tonumber(road.width_m) or 7) * S, 3)
	node.xSum += x
	node.zSum += z
	node.count += 1
    local peerKey = endpointKeyFromStuds(ox, oz, gradeLevel, endpointConnectionGroup(road, 3 - endpointIndex))
    node.links[peerKey] = math.sqrt((ox-x)^2 + (oz-z)^2)
	node.maxWidth = math.max(node.maxWidth, roadWidth)
	local name = tostring(road.junction_name or road.name or "")
	if name ~= "" and name ~= "Road" then
		node.names[name] = true
	end
	local dx = ox - x
	local dz = oz - z
	local length = math.sqrt(dx * dx + dz * dz)
	if length > 0.001 then
		table.insert(node.rawArms, {
			name = name,
			width = roadWidth,
			length = length,
            peerKey = peerKey,
			dir = Vector3.new(dx / length, 0, dz / length),
		})
	end
end

local function finalizeNodes(nodes)
	for _, node in pairs(nodes) do
		local distinctNames = 0
		for _ in pairs(node.names) do
			distinctNames += 1
		end
		local armMap = {}
		for _, arm in ipairs(node.rawArms) do
			local key = armKey(arm.name, arm.dir)
			local current = armMap[key]
			if not current or arm.width > current.width
                or (arm.width == current.width and arm.length > current.length) then
				armMap[key] = arm
			end
		end
		local arms = {}
		for _, arm in pairs(armMap) do
			table.insert(arms, arm)
		end
		table.sort(arms, function(a, b)
			return math.atan2(a.dir.Z, a.dir.X) < math.atan2(b.dir.Z, b.dir.X)
		end)
		node.rawArms = nil
		node.arms = arms
		node.distinctNames = distinctNames
		node.isNamedIntersection = distinctNames >= 2
		node.isIntersection = node.gradeLevel == 0
			and (#arms >= WorldConfig.INTERSECTION_MIN_DEGREE or node.isNamedIntersection)
		node.x = node.xSum / math.max(node.count, 1)
		node.z = node.zSum / math.max(node.count, 1)
		if node.isIntersection then
			node.polygon = polygonFromNode(node)
            local r = 0
            for _, p in ipairs(node.polygon) do
                local dx, dz = p.X - node.x, p.Y - node.z
                r = math.max(r, math.sqrt(dx * dx + dz * dz))
            end
            node.outerRadius = r
		end
	end
end

-- Join directly connected, tightly spaced same-grade junctions so they
-- share ONE asphalt polygon instead of three overlapping intersection pads.
-- This is essential for the 9th/Kerlin-Concord triangle (~20m apart).
local function prepareJunctionGroups(nodes)
    local parent = {}
    for key, node in pairs(nodes) do
        if node.isIntersection then parent[key] = key end
    end

    local function root(key)
        if parent[key] == nil then return nil end
        while parent[key] ~= key do
            parent[key] = parent[parent[key]]
            key = parent[key]
        end
        return key
    end

    for key, node in pairs(nodes) do
        if parent[key] then
            for peerKey, linkLength in pairs(node.links or {}) do
                local other = nodes[peerKey]
                if other and parent[peerKey] and other.gradeLevel == node.gradeLevel then
                    if linkLength <= 0.95 * (node.maxWidth + other.maxWidth) then
                        local a, b = root(key), root(peerKey)
                        if a and b and a ~= b then parent[b] = a end
                    end
                end
            end
        end
    end

    local candidateGroups = {}
    for key, node in pairs(nodes) do
        if node.isIntersection then
            local groupKey = root(key)
            local group = candidateGroups[groupKey]
            if not group then
                group = { members = {}, memberKeys = {} }
                candidateGroups[groupKey] = group
            end
            table.insert(group.members, node)
            group.memberKeys[key] = true
        end
    end

    local groups = {}
    local mergedGroups, mergedNodes = 0, 0
    local groupSerial = 0
    for _, candidate in pairs(candidateGroups) do
        local members = candidate.members
        local maxWidth, diameter = 0, 0
        for i, a in ipairs(members) do
            maxWidth = math.max(maxWidth, a.maxWidth)
            for j = i + 1, #members do
                local b = members[j]
                diameter = math.max(diameter,
                    math.sqrt((a.x - b.x)^2 + (a.z - b.z)^2))
            end
        end
        local canMerge = #members > 1
            and diameter <= math.max(120, 2.8 * maxWidth)
        if canMerge then
            local points, names, approaches = {}, {}, {}
            local xSum, zSum, owner = 0, 0, nil
            for _, member in ipairs(members) do
                xSum += member.x
                zSum += member.z
                if not owner or member.ownerTile < owner then
                    owner = member.ownerTile
                end
                for name in pairs(member.names) do names[name] = true end
                for _, p in ipairs(member.polygon or {}) do
                    table.insert(points, p)
                end
                for _, arm in ipairs(member.arms) do
                    if not candidate.memberKeys[arm.peerKey] then
                        table.insert(approaches, {
                            name = arm.name,
                            width = arm.width,
                            length = arm.length,
                            dir = arm.dir,
                            originNode = member,
                        })
                    end
                end
            end
            local polygon = convexHull(points)
            if #polygon >= 3 then
                groupSerial += 1
                for _, member in ipairs(members) do
                    member.polygon = polygon
                    member.clusterId = groupSerial
                end
                local x = xSum / #members
                local z = zSum / #members
                local renderNode = {
                    x = x, z = z, polygon = polygon,
                    maxWidth = maxWidth, names = names,
                    arms = approaches, isIntersection = true,
                    isNamedIntersection = true, clusterId = groupSerial,
                }
                table.insert(groups, {
                    ownerTile = owner, renderNode = renderNode,
                    members = members, merged = true,
                })
                mergedGroups += 1
                mergedNodes += #members
            else
                canMerge = false
            end
        end
        if not canMerge then
            for _, member in ipairs(members) do
                groupSerial += 1
                member.clusterId = groupSerial
                table.insert(groups, {
                    ownerTile = member.ownerTile,
                    renderNode = member,
                    members = {member}, merged = false,
                })
            end
        end
    end
    for _, group in ipairs(groups) do
        local node = group.renderNode
        local radius = 0
        for _, p in ipairs(node.polygon or {}) do
            radius = math.max(radius,
                math.sqrt((p.X - node.x)^2 + (p.Y - node.z)^2))
        end
        node.outerRadius = radius
    end
    return groups, mergedGroups, mergedNodes
end

function TileBuilderV2.Prepare(tileModules)
	globalIntersectionNodes = {}
	for moduleIndex, tileModule in ipairs(tileModules) do
		if tileModule:IsA("ModuleScript") then
			local ok, tile = pcall(require, tileModule)
			if ok and tile then
				local tileId = tostring(tile.tile_id or tileModule.Name)
				for roadIndex, road in ipairs(tile.roads or {}) do
					addEndpoint(globalIntersectionNodes, tileId, road.x1, road.z1, road.x2, road.z2, road, 1)
					addEndpoint(globalIntersectionNodes, tileId, road.x2, road.z2, road.x1, road.z1, road, 2)
					if roadIndex % 250 == 0 then task.wait() end
				end
			end
		end
		if moduleIndex % 8 == 0 then task.wait() end
	end
	finalizeNodes(globalIntersectionNodes)
    local mergedGroups, mergedNodes
    globalJunctionGroups, mergedGroups, mergedNodes =
        prepareJunctionGroups(globalIntersectionNodes)
    proximityGrid = {}
    for _, group in ipairs(globalJunctionGroups) do
        local node = group.renderNode
        local key = proximityKey(node.x, node.z)
        if not proximityGrid[key] then proximityGrid[key] = {} end
        table.insert(proximityGrid[key], node)
    end
	prepared = true
	local nodeCount = 0
	local intersections = 0
	for _, node in pairs(globalIntersectionNodes) do
		nodeCount += 1
		if node.isIntersection then intersections += 1 end
	end
	print(("[ChesterWorld TileBuilderV2] prepared global road graph: nodes=%d intersections=%d junctionSurfaces=%d mergedGroups=%d mergedNodes=%d polygonOwned=true"):format(nodeCount, intersections, #globalJunctionGroups, mergedGroups, mergedNodes))
end

local function pointAlong2D(a, b, distanceFromA)
	local dx = b.X - a.X
	local dz = b.Z - a.Z
	local length = math.sqrt(dx * dx + dz * dz)
	if length < 0.001 then return a end
	local t = math.clamp(distanceFromA / length, 0, 1)
	return Vector3.new(a.X + dx * t, 0, a.Z + dz * t)
end

local function trimDistanceForNode(node, dir, extraClearance, halfWidth)
    if not node or not node.isIntersection then return 0 end
    -- Roads must reach the nearest edge across their FULL width. Centerline-
    -- only trimming previously left triangular holes on diagonal approaches.
    local boundary = polygonArmBoundary(node, dir, halfWidth or 0, false)
    return math.max(0,
        boundary - WorldConfig.INTERSECTION_ROAD_OVERLAP_STUDS
        + (extraClearance or 0))
end

local function trimmedEndpoints(road, extraClearance)
	local x1, z1 = sourceToStuds(road.x1, road.z1)
	local x2, z2 = sourceToStuds(road.x2, road.z2)
	local a = Vector3.new(x1, 0, z1)
	local b = Vector3.new(x2, 0, z2)
	local length = horizontalLength(a, b)
	if length < 0.05 then return nil, nil end
	local startNode = globalIntersectionNodes[endpointKeyFromMeters(road.x1, road.z1, road, 1)]
	local endNode = globalIntersectionNodes[endpointKeyFromMeters(road.x2, road.z2, road, 2)]
	local startDir = (b - a).Unit
	local endDir = (a - b).Unit
	local startClearance = extraClearance
    local endClearance = extraClearance
    if type(extraClearance) == "table" then
        startClearance = extraClearance.start or 0
        endClearance = extraClearance.finish or 0
    end
    -- A painted centerline has negligible width. Asphalt/sidewalk approaches
    -- use both pavement edges to prevent gaps beside skewed junctions.
    local halfWidth = 0
    if type(extraClearance) ~= "table" then
        halfWidth = math.max((tonumber(road.width_m) or 7) * S / 2 - 0.25, 1)
    end
	local trimStart = trimDistanceForNode(startNode, startDir, startClearance, halfWidth)
	local trimEnd = trimDistanceForNode(endNode, endDir, endClearance, halfWidth)
	if trimStart + trimEnd >= length - 1.0 then return nil, nil end
	return pointAlong2D(a, b, trimStart), pointAlong2D(b, a, trimEnd)
end

local function shouldSplit(a, b, depth, surfaceOffset, gradeOffset)
	if depth >= WorldConfig.ROAD_MAX_SUBDIVISION_DEPTH then return false end
	if horizontalLength(a, b) > WorldConfig.ROAD_MAX_PIECE_LENGTH_STUDS then return true end
	local midX = (a.X + b.X) / 2
	local midZ = (a.Z + b.Z) / 2
	local groundMid = terrainY(midX, midZ)
	if groundMid == nil then return false end
	local terrainMidY = groundMid + surfaceOffset + (gradeOffset or 0)
	local linearMidY = (a.Y + b.Y) / 2
	return math.abs(terrainMidY - linearMidY) > WorldConfig.ROAD_TERRAIN_ERROR_STUDS
end

local function buildAdaptiveCenterStrip(parent, name, x1, z1, x2, z2, width, thickness, material, color, surfaceOffset, gradeOffset, depth, attributes)
	depth = depth or 0
	gradeOffset = gradeOffset or 0
	local a, b = safeGroundPair(x1, z1, x2, z2, surfaceOffset, gradeOffset)
	if not a or not b then return end
	if shouldSplit(a, b, depth, surfaceOffset, gradeOffset) then
		local midX = (x1 + x2) / 2
		local midZ = (z1 + z2) / 2
		buildAdaptiveCenterStrip(parent, name, x1, z1, midX, midZ, width, thickness, material, color, surfaceOffset, gradeOffset, depth + 1, attributes)
		buildAdaptiveCenterStrip(parent, name, midX, midZ, x2, z2, width, thickness, material, color, surfaceOffset, gradeOffset, depth + 1, attributes)
		return
	end
	local part = makeStripPart(parent, name, a, b, width, thickness, material, color)
	if part and attributes then
		for key, value in pairs(attributes) do part:SetAttribute(key, value) end
	end
end

local function roadAttributes(road, roadWidth)
	local level = gradeLevelForRoad(road)
	local bridge = truthy(road.bridge)
	local tunnel = truthy(road.tunnel)
	return {
		ChesterStreet = tostring(road.name or ""),
		RoadWidthStuds = roadWidth,
		CW_RoadClass = tostring(road.road_class or ""),
		CW_GradeLevel = level,
		CW_Bridge = bridge,
		CW_Tunnel = tunnel,
		CW_GradeSeparated = level ~= 0 or bridge or tunnel,
		CW_GradeGroup = tostring(road.grade_group or ""),
		CW_GradeClearanceStuds = math.max(level, 0) * WorldConfig.GRADE_SEPARATION_CLEARANCE_STUDS,
	}
end

local function buildSidewalkPair(sidewalksFolder, streetName, a2D, b2D, roadWidth)
	if not a2D or not b2D then return end
	local perpendicular = horizontalPerpendicular(a2D, b2D)
	local sidewalkWidth = WorldConfig.SIDEWALK_WIDTH_STUDS
	local offsetDistance = roadWidth / 2 + WorldConfig.SIDEWALK_GAP_STUDS + sidewalkWidth / 2
	local sidewalkSurfaceOffset = WorldConfig.SIDEWALK_HEIGHT_STUDS / 2 + 0.15
	for _, sign in ipairs({ -1, 1 }) do
		local offset = perpendicular * offsetDistance * sign
		buildAdaptiveCenterStrip(
			sidewalksFolder, "Sidewalk",
			a2D.X + offset.X, a2D.Z + offset.Z,
			b2D.X + offset.X, b2D.Z + offset.Z,
			sidewalkWidth,
			WorldConfig.SIDEWALK_HEIGHT_STUDS,
			WorldConfig.SIDEWALK_MATERIAL,
			WorldConfig.SIDEWALK_COLOR,
			sidewalkSurfaceOffset, 0, 0,
			{ ChesterStreet = streetName, Side = sign < 0 and "Left" or "Right", CW_TileBuilderSidewalk = true }
		)
	end
end

local function buildCenterLine(markingsFolder, road, roadWidth)
    if roadWidth < WorldConfig.CENTERLINE_MIN_ROAD_WIDTH_STUDS then return end
    local streetName = tostring(road.name or "")
    if streetName == "" or streetName == "Road" then return end
    local sx, sz = sourceToStuds(road.x1, road.z1)
    local ex, ez = sourceToStuds(road.x2, road.z2)
    local delta = Vector3.new(ex - sx, 0, ez - sz)
    if delta.Magnitude < 0.05 then return end
    local startDir = delta.Unit
    local endDir = -startDir

    local function clearance(node, dir)
        if not node or not node.isIntersection then return 0.5 end
        if node.isNamedIntersection
            and node.maxWidth >= WorldConfig.CROSSWALK_TRIGGER_WIDTH_STUDS
            and roadWidth >= WorldConfig.CROSSWALK_MIN_ARM_WIDTH_STUDS
        then
            local stripes = WorldConfig.CROSSWALK_STRIPE_COUNT
            local span = stripes * WorldConfig.CROSSWALK_STRIPE_DEPTH_STUDS
                + (stripes - 1) * WorldConfig.CROSSWALK_STRIPE_GAP_STUDS
            local centerEdge = polygonArmBoundary(node, dir, 0, false)
            local outerEdge = polygonArmBoundary(node, dir,
                math.max(roadWidth - 2.0, 4.0) / 2, true)
            -- Matches the actual FULL-WIDTH crosswalk setback. Yellow lines
            -- stop BEFORE the zebra, including on a strongly skewed corner.
            return math.max(0, outerEdge - centerEdge)
                + WorldConfig.CROSSWALK_EDGE_CLEARANCE_STUDS
                + span + 2.0
        end
        return 2.0
    end

    local startNode = globalIntersectionNodes[
        endpointKeyFromMeters(road.x1, road.z1, road, 1)]
    local endNode = globalIntersectionNodes[
        endpointKeyFromMeters(road.x2, road.z2, road, 2)]
    local a2D, b2D = trimmedEndpoints(road, {
        start = clearance(startNode, startDir),
        finish = clearance(endNode, endDir),
    })
    if not a2D or not b2D then return end
    buildAdaptiveCenterStrip(
        markingsFolder, "CenterLine",
        a2D.X, a2D.Z, b2D.X, b2D.Z,
        WorldConfig.CENTERLINE_WIDTH_STUDS,
        WorldConfig.CENTERLINE_THICKNESS_STUDS,
        WorldConfig.MARKING_MATERIAL,
        WorldConfig.CENTERLINE_COLOR,
        WorldConfig.CENTERLINE_SURFACE_OFFSET_STUDS,
        gradeOffsetForRoad(road), 0,
        {
            ChesterStreet = streetName,
            MarkingType = "CenterLine",
            CW_GradeLevel = gradeLevelForRoad(road),
            CW_GradeGroup = tostring(road.grade_group or ""),
            CW_Bridge = truthy(road.bridge),
            CW_Tunnel = truthy(road.tunnel),
            CW_RoadClass = tostring(road.road_class or ""),
        }
    )
end

local function buildRoad(roadsFolder, sidewalksFolder, markingsFolder, road)
	local roadWidth = math.max((tonumber(road.width_m) or 7) * S, 3)
	local streetName = tostring(road.name or "")
	local a2D, b2D = trimmedEndpoints(road, 0)
	if a2D and b2D then
		buildAdaptiveCenterStrip(
			roadsFolder,
			streetName ~= "" and streetName or "Road",
			a2D.X, a2D.Z, b2D.X, b2D.Z,
			roadWidth,
			WorldConfig.ROAD_THICKNESS_STUDS,
			WorldConfig.ROAD_MATERIAL,
			WorldConfig.ROAD_COLOR,
			WorldConfig.ROAD_SURFACE_OFFSET_STUDS,
			gradeOffsetForRoad(road), 0,
			roadAttributes(road, roadWidth)
		)
	end
	if streetName ~= "" and streetName ~= "Road" and shouldBuildSidewalk(road) then
		local sidewalkA, sidewalkB = trimmedEndpoints(road, WorldConfig.SIDEWALK_INTERSECTION_EXTRA_TRIM_STUDS)
		buildSidewalkPair(sidewalksFolder, streetName, sidewalkA, sidewalkB, roadWidth)
	end
	buildCenterLine(markingsFolder, road, roadWidth)
end

local function uniqueIntersectionNames(node)
	local labels = {}
	for name in pairs(node.names) do table.insert(labels, name) end
	table.sort(labels)
	return labels
end

local function buildCrosswalkForArm(markingsFolder, node, arm)
	if arm.width < WorldConfig.CROSSWALK_MIN_ARM_WIDTH_STUDS then return end
	local dir = arm.dir
	if dir.Magnitude < 0.001 then return end
	local perpendicular = Vector3.new(-dir.Z, 0, dir.X)
    -- Start AFTER the farthest polygon corner across the complete zebra width.
    -- Measuring only the center previously let half the crosswalk sit on the
    -- junction asphalt at diagonal/skewed approaches.
    local usableWidth = math.max(arm.width - 2.0, 4.0)
    local halfAcross = usableWidth / 2
    local baseSetback = polygonArmBoundary(node, dir, halfAcross, true)
        + WorldConfig.CROSSWALK_EDGE_CLEARANCE_STUDS
    local stripeSpan = WorldConfig.CROSSWALK_STRIPE_COUNT * WorldConfig.CROSSWALK_STRIPE_DEPTH_STUDS
        + (WorldConfig.CROSSWALK_STRIPE_COUNT - 1) * WorldConfig.CROSSWALK_STRIPE_GAP_STUDS
    -- A short source segment cannot fit a crosswalk before its next junction.
    if arm.length and arm.length < baseSetback + stripeSpan + 4 then return end
    -- The connected road can run through another very nearby intersection.
    -- Never paint a crosswalk across a second junction's asphalt.
    local midpoint = Vector3.new(node.x, 0, node.z)
        + dir * (baseSetback + stripeSpan / 2)
    local gx, gz = proximityCell(midpoint.X, midpoint.Z)
    for ix = gx - 1, gx + 1 do
        for iz = gz - 1, gz + 1 do
            local bucket = proximityGrid[tostring(ix) .. ":" .. tostring(iz)]
            for _, other in ipairs(bucket or {}) do
                if other.clusterId ~= node.clusterId then
                    local dx, dz = midpoint.X - other.x, midpoint.Z - other.z
                    local required = (other.outerRadius or 0) + stripeSpan / 2 + 3
                    if dx * dx + dz * dz < required * required then return end
                end
            end
        end
    end
	for stripe = 0, WorldConfig.CROSSWALK_STRIPE_COUNT - 1 do
		local along = baseSetback + stripe * (WorldConfig.CROSSWALK_STRIPE_DEPTH_STUDS + WorldConfig.CROSSWALK_STRIPE_GAP_STUDS)
		local center = Vector3.new(node.x, 0, node.z) + dir * along
		local p1 = center - perpendicular * halfAcross
		local p2 = center + perpendicular * halfAcross
		local a, b = safeGroundPair(p1.X, p1.Z, p2.X, p2.Z, WorldConfig.CROSSWALK_SURFACE_OFFSET_STUDS, 0)
		local stripePart = makeStripPart(
			markingsFolder, "Crosswalk", a, b,
			WorldConfig.CROSSWALK_STRIPE_DEPTH_STUDS,
			WorldConfig.CROSSWALK_THICKNESS_STUDS,
			WorldConfig.MARKING_MATERIAL,
			WorldConfig.CROSSWALK_COLOR
		)
		if stripePart then
			stripePart:SetAttribute("MarkingType", "Crosswalk")
			stripePart:SetAttribute("ChesterStreet", tostring(arm.name or ""))
		end
	end
end

local function bestPerpendicularArmPair(node)
	local bestA, bestB = nil, nil
	local bestScore = math.huge
	for i = 1, #node.arms do
		local a = node.arms[i]
		if a.name ~= "" and a.name ~= "Road" then
			for j = i + 1, #node.arms do
				local b = node.arms[j]
				if b.name ~= "" and b.name ~= "Road" and b.name ~= a.name then
					local score = math.abs(a.dir:Dot(b.dir))
					if score < bestScore then bestScore, bestA, bestB = score, a, b end
				end
			end
		end
	end
	return bestA, bestB
end

local function polygonMaxRadius(node)
	local best = 0
	for _, p in ipairs(node.polygon or {}) do
		local dx = p.X - node.x
		local dz = p.Y - node.z
		best = math.max(best, math.sqrt(dx * dx + dz * dz))
	end
	return best
end

local function buildStreetSign(signsFolder, node, labels)
	if not node.isNamedIntersection or node.maxWidth < WorldConfig.STREET_SIGN_TRIGGER_WIDTH_STUDS or #labels < 2 then return end
	local armA, armB = bestPerpendicularArmPair(node)
	if not armA or not armB then return end
	local cornerDir = armA.dir + armB.dir
	if cornerDir.Magnitude < 0.001 then cornerDir = Vector3.new(1, 0, 1) end
	cornerDir = cornerDir.Unit
	local distance = polygonMaxRadius(node) + WorldConfig.STREET_SIGN_CORNER_CLEARANCE_STUDS
	local signX = node.x + cornerDir.X * distance
	local signZ = node.z + cornerDir.Z * distance
	local ground = terrainY(signX, signZ)
	if ground == nil then return end
	local poleHeight = WorldConfig.STREET_SIGN_POLE_HEIGHT_STUDS
	local pole = Instance.new("Part")
	pole.Name = "StreetSign"
	pole.Anchored = true
	pole.CanCollide = false
	pole.Material = WorldConfig.SIGN_POLE_MATERIAL
	pole.Color = WorldConfig.SIGN_POLE_COLOR
	pole.Size = Vector3.new(WorldConfig.STREET_SIGN_POLE_THICKNESS_STUDS, poleHeight, WorldConfig.STREET_SIGN_POLE_THICKNESS_STUDS)
	pole.Position = Vector3.new(signX, ground + poleHeight / 2, signZ)
	pole.Parent = signsFolder
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "StreetNames"
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 360
	billboard.Size = UDim2.fromOffset(190, 48)
	billboard.StudsOffset = Vector3.new(0, poleHeight / 2 + 2.5, 0)
	billboard.Parent = pole
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = WorldConfig.SIGN_BACKGROUND_COLOR
	label.BackgroundTransparency = 0.03
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = WorldConfig.SIGN_TEXT_COLOR
	label.TextSize = 15
	label.TextWrapped = true
	label.Text = string.upper(labels[1] .. " / " .. labels[2])
	label.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = label
	pole:SetAttribute("Intersection", labels[1] .. " & " .. labels[2])
end

local function intersectionFrame(x, z, radius)
	local centerGround = terrainY(x, z)
	if centerGround == nil then return nil end
	local sample = math.clamp(radius * 0.28, 4, 12)
	local east = terrainY(x + sample, z) or centerGround
	local west = terrainY(x - sample, z) or centerGround
	local south = terrainY(x, z + sample) or centerGround
	local north = terrainY(x, z - sample) or centerGround
	local gradeX = math.clamp((east - west) / (sample * 2), -WorldConfig.INTERSECTION_MAX_GRADE, WorldConfig.INTERSECTION_MAX_GRADE)
	local gradeZ = math.clamp((south - north) / (sample * 2), -WorldConfig.INTERSECTION_MAX_GRADE, WorldConfig.INTERSECTION_MAX_GRADE)
	local up = Vector3.new(-gradeX, 1, -gradeZ).Unit
	local right = Vector3.new(1, gradeX, 0).Unit
	local back = right:Cross(up).Unit
	right = up:Cross(back).Unit
	return CFrame.fromMatrix(
		Vector3.new(x, centerGround + WorldConfig.ROAD_SURFACE_OFFSET_STUDS, z),
		right, up, back
	)
end

local function planeYAtFrame(frame, x, z, yOffset)
	local normal = frame.UpVector
	local planePoint = frame.Position + normal * (yOffset or 0)
	if math.abs(normal.Y) < 0.001 then return planePoint.Y end
	return planePoint.Y - (normal.X * (x - planePoint.X) + normal.Z * (z - planePoint.Z)) / normal.Y
end


-- Solid convex polygon, built from ordinary Roblox WedgeParts.
-- Two wedges fill each triangle (the standard 3D-triangle decomposition).
-- This avoids EditableMesh API permissions, winding problems and MeshPart pivots.
local function fillTriangleWithWedges(parent, a, b, c, thickness, labels)
    local ab, ac, bc = b - a, c - a, c - b
    local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
    if abd > acd and abd > bcd then
        c, a = a, c
    elseif acd > bcd and acd > abd then
        a, b = b, a
    end
    ab, ac, bc = b - a, c - a, c - b
    local normal = ac:Cross(ab)
    if normal.Magnitude < 0.01 or bc.Magnitude < 0.1 then return 0 end
    local right = normal.Unit
    local up = bc:Cross(right).Unit
    local back = bc.Unit
    local height = math.abs(ab:Dot(up))
    if height < 0.08 then return 0 end
    local count = 0

    local function buildWedge(position, xAxis, yAxis, zAxis, depth)
        if depth < 0.08 then return end
        local wedge = Instance.new("WedgePart")
        wedge.Name = "IntersectionAsphalt"
        wedge.Anchored = true
        wedge.CanCollide = true
        wedge.CanTouch = true
        wedge.CanQuery = true
        -- Separate wedge pieces would otherwise shadow one another at
        -- their internal shared edges and draw dark zigzag seams.
        wedge.CastShadow = false
        wedge.TopSurface = Enum.SurfaceType.Smooth
        wedge.BottomSurface = Enum.SurfaceType.Smooth
        wedge.Material = WorldConfig.INTERSECTION_MATERIAL
        wedge.Color = WorldConfig.INTERSECTION_COLOR
        wedge.Size = Vector3.new(thickness, height, depth)
        wedge.CFrame = CFrame.fromMatrix(position, xAxis, yAxis, zAxis)
        wedge:SetAttribute("CW_IntersectionPad", true)
        wedge:SetAttribute("CW_IntersectionSolid", true)
        wedge:SetAttribute("CW_IntersectionOwner", "TileBuilderV3")
        wedge:SetAttribute("CW_GradeLevel", 0)
        if #labels > 0 then wedge:SetAttribute("Intersection", table.concat(labels, " & ")) end
        wedge.Parent = parent
        count += 1
    end
    buildWedge((a + b) / 2, right, up, back, math.abs(ab:Dot(back)))
    buildWedge((a + c) / 2, -right, up, -back, math.abs(ac:Dot(back)))
    return count
end

local function makeIntersectionMesh(parent, node, labels)
    local polygon = node.polygon
    if not polygon or #polygon < 3 then return nil end
    local radius = polygonMaxRadius(node)
    local frame = intersectionFrame(node.x, node.z, radius)
    if not frame then return nil end
    local thickness = WorldConfig.ROAD_THICKNESS_STUDS + 0.12
    local surfaceOffset = thickness / 2 + 0.10

    -- Build from the SAME node.polygon used by rayPolygonDistance and trimming.
    -- A center fan of a convex polygon has no holes and no oversized bbox.
    local function pointAt(x, z)
        local topY = planeYAtFrame(frame, x, z, surfaceOffset)
        return Vector3.new(x, topY - thickness / 2, z)
    end
    local center = pointAt(node.x, node.z)
    local group = Instance.new("Model")
    group.Name = "Intersection"
    group:SetAttribute("CW_IntersectionPad", true)
    group:SetAttribute("CW_IntersectionSolid", true)
    group:SetAttribute("CW_IntersectionOwner", "TileBuilderV3")
    group:SetAttribute("CW_IntersectionPolygon", true)
    if #labels > 0 then group:SetAttribute("Intersection", table.concat(labels, " & ")) end
    local count = 0
    for i = 1, #polygon do
        local b = polygon[i]
        local c = polygon[(i % #polygon) + 1]
        count += fillTriangleWithWedges(
            group, center, pointAt(b.X, b.Y), pointAt(c.X, c.Y),
            thickness, labels
        )
    end
    -- If all triangles were degenerate, use the existing visible fallback.
    if count < 3 then group:Destroy(); return nil end
    group.Parent = parent
    return group
end

local function makeIntersectionFallback(parent, node, labels)
	local radius = math.max(node.maxWidth * 0.55, 6)
	local frame = intersectionFrame(node.x, node.z, radius)
	if not frame then return nil end
	local pad = Instance.new("Part")
	pad.Name = "IntersectionFallback"
	pad.Anchored = true
	pad.CanCollide = true
	pad.CanTouch = true
	pad.CanQuery = true
	pad.Material = WorldConfig.INTERSECTION_MATERIAL
	pad.Color = WorldConfig.INTERSECTION_COLOR
	pad.TopSurface = Enum.SurfaceType.Smooth
	pad.BottomSurface = Enum.SurfaceType.Smooth
	pad.Size = Vector3.new(radius * 2, WorldConfig.ROAD_THICKNESS_STUDS + 0.08, radius * 2)
	pad.CFrame = frame
	pad:SetAttribute("CW_IntersectionPad", true)
	pad:SetAttribute("CW_IntersectionFallback", true)
	if #labels > 0 then pad:SetAttribute("Intersection", table.concat(labels, " & ")) end
	pad.Parent = parent
	return pad
end

local function buildIntersections(parent, markingsFolder, signsFolder, tileId)
    local processed = 0
    -- Render ONE polygon for an entire connected nearby-junction group.
    -- Each member's source-road ends are trimmed to that same polygon.
    for _, group in ipairs(globalJunctionGroups) do
        if group.ownerTile == tileId then
            local node = group.renderNode
            local labels = uniqueIntersectionNames(node)
            local pad = makeIntersectionMesh(parent, node, labels)
            if not pad then makeIntersectionFallback(parent, node, labels) end
            if node.isNamedIntersection
                and node.maxWidth >= WorldConfig.CROSSWALK_TRIGGER_WIDTH_STUDS
            then
                local physicalApproaches = {}
                for _, arm in ipairs(node.arms) do
                    local originNode = arm.originNode or node
                    local matchingIndex = nil
                    for index, existing in ipairs(physicalApproaches) do
                        local previousOrigin = existing.originNode or node
                        local dx = originNode.x - previousOrigin.x
                        local dz = originNode.z - previousOrigin.z
                        if existing.dir:Dot(arm.dir) > 0.985
                            and dx * dx + dz * dz <
                                math.max(existing.width, arm.width)^2
                        then
                            matchingIndex = index
                            break
                        end
                    end
                    if matchingIndex then
                        if arm.width > physicalApproaches[matchingIndex].width then
                            physicalApproaches[matchingIndex] = arm
                        end
                    else
                        table.insert(physicalApproaches, arm)
                    end
                end
                for _, arm in ipairs(physicalApproaches) do
                    buildCrosswalkForArm(markingsFolder, arm.originNode or node, arm)
                end
            end
            buildStreetSign(signsFolder, node, labels)
            processed += 1
            if processed % INTERSECTION_YIELD_EVERY == 0 then task.wait() end
        end
    end
end

local function buildBuilding(parent, building)
	local heightStuds = math.max((building.height_m or 9.15) * S, 2)
	local widthStuds = math.max((building.width_m or 5) * S, 1)
	local depthStuds = math.max((building.depth_m or 8) * S, 1)
	local x, z = sourceToStuds(building.x_m, building.z_m)
	local groundY = terrainY(x, z)
	if groundY == nil then return end
	local y = groundY + WorldConfig.BUILDING_BASE_Y_STUDS + heightStuds / 2
	local part = Instance.new("Part")
	part.Name = building.name or building.id or "Building"
	part.Anchored = true
	part.CanCollide = true
	part.Material = WorldConfig.BUILDING_MATERIAL
	part.Size = Vector3.new(widthStuds, heightStuds, depthStuds)
	part.CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(building.yaw_deg or 0), 0)
	part.Parent = parent
	part:SetAttribute("ChesterBuildingId", tostring(building.id or ""))
	part:SetAttribute("SourceHeightMeters", building.height_m or 9.15)
	part:SetAttribute("GroundY", groundY)
end

function TileBuilderV2.Build(tileModule)
	if not prepared then error("TileBuilderV2.Prepare(modules) must run before Build") end
	local tile = require(tileModule)
	local tileId = tostring(tile.tile_id or tileModule.Name)
	local workspaceRoot = workspace:FindFirstChild("ChesterWorld")
	if not workspaceRoot then
		workspaceRoot = Instance.new("Folder")
		workspaceRoot.Name = "ChesterWorld"
		workspaceRoot.Parent = workspace
	end
	local tileFolder = workspaceRoot:FindFirstChild(tileId)
	if tileFolder then tileFolder:Destroy() end
	tileFolder = Instance.new("Folder")
	tileFolder.Name = tileId
	tileFolder:SetAttribute("TileId", tileId)
	tileFolder.Parent = workspaceRoot
	local roadsFolder = makeFolder(tileFolder, "Roads")
	local sidewalksFolder = makeFolder(tileFolder, "Sidewalks")
	local intersectionsFolder = makeFolder(tileFolder, "Intersections")
	local markingsFolder = makeFolder(tileFolder, "RoadMarkings")
	local signsFolder = makeFolder(tileFolder, "StreetSigns")
	local buildingsFolder = makeFolder(tileFolder, "Buildings")
	for index, road in ipairs(tile.roads or {}) do
		buildRoad(roadsFolder, sidewalksFolder, markingsFolder, road)
		if index % ROAD_YIELD_EVERY == 0 then task.wait() end
	end
	buildIntersections(intersectionsFolder, markingsFolder, signsFolder, tileId)
	for index, building in ipairs(tile.buildings or {}) do
		buildBuilding(buildingsFolder, building)
		if index % BUILDING_YIELD_EVERY == 0 then task.wait() end
	end
	return tileFolder
end

return TileBuilderV2
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1655">
            <Properties>
              <string name="Name">TileBuilderV3</string>
              <string name="Source"><![CDATA[-- The one active street builder: TileBuilderV2 owns the global graph,
-- all road trimming, and solid polygon junction paving in the same pass.
-- V3 keeps the Bootstrap entrypoint stable; it must NOT replace the
-- graph-defined polygon with an axis-aligned rectangle.
local BaseBuilder = require(script.Parent:WaitForChild("TileBuilderV2"))
local TileBuilderV3 = {}
local expectedTiles = 0
local builtTiles = 0
local polygonCenters = 0
local fallbackCenters = 0
local polygonPieces = 0

function TileBuilderV3.Prepare(tileModules)
    expectedTiles = #tileModules
    builtTiles = 0
    polygonCenters = 0
    fallbackCenters = 0
    polygonPieces = 0
    BaseBuilder.Prepare(tileModules)
    print(("[ChesterWorld TileBuilderV3] polygon paving uses solid WedgeParts; tiles=%d noEditableMesh=true"):format(expectedTiles))
end

-- Used only for the optional 5-tile Studio preview. Global graph
-- preparation still receives all 102 modules.
function TileBuilderV3.SetExpectedTiles(count)
    expectedTiles = math.max(1, math.min(expectedTiles, count))
end

function TileBuilderV3.Build(tileModule)
    local tileFolder = BaseBuilder.Build(tileModule)
    local intersections = tileFolder:FindFirstChild("Intersections")
    if intersections then
        for _, item in ipairs(intersections:GetChildren()) do
            if item:IsA("Model") and item:GetAttribute("CW_IntersectionPolygon") then
                polygonCenters += 1
                polygonPieces += #item:GetChildren()
            elseif item:IsA("BasePart") and item:GetAttribute("CW_IntersectionFallback") then
                fallbackCenters += 1
            end
        end
    end
    builtTiles += 1
    if builtTiles == expectedTiles then
        print(("[ChesterWorld TileBuilderV3] complete tiles=%d polygonCenters=%d wedgeParts=%d fallbacks=%d noEditableMesh=true")
            :format(builtTiles, polygonCenters, polygonPieces, fallbackCenters))
    end
    return tileFolder
end

return TileBuilderV3
