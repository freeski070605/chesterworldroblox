        <Item class="ModuleScript" referent="1645">
          <Properties>
            <string name="Name">WorldPlacement</string>
            <string name="Source"><![CDATA[-- STAGED REGIONAL PLACEMENT — DO NOT RENAME INTO PLACE UNTIL REGIONAL TERRAIN IS IMPORTED.
-- Existing Chester coordinates are preserved by the regional origin/center shift.
-- Roblox orientation remains locked: N=-Z, S=+Z, E=+X, W=-X

return {
    STUDS_PER_METER = 3.000000,
    CENTER_X_M = 6347.889,
    CENTER_Z_M = 7201.973,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1646">
          <Properties>
            <string name="Name">WorldPlacement.regional.staged</string>
            <string name="Source"><![CDATA[-- STAGED REGIONAL PLACEMENT — DO NOT RENAME INTO PLACE UNTIL REGIONAL TERRAIN IS IMPORTED.
-- Existing Chester coordinates are preserved by the regional origin/center shift.
-- Roblox orientation remains locked: N=-Z, S=+Z, E=+X, W=-X

