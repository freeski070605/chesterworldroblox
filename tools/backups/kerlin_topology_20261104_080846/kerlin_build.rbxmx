coords.TextSize = 13
coords.TextXAlignment = Enum.TextXAlignment.Left
coords.TextColor3 = Color3.fromRGB(230, 230, 230)
coords.Text = "X 0   Y 0   Z 0"
coords.Parent = panel

local compass = Instance.new("TextLabel")
compass.BackgroundTransparency = 1
compass.Position = UDim2.fromOffset(14, 76)
compass.Size = UDim2.new(1, -28, 0, 20)
compass.Font = Enum.Font.GothamBold
compass.TextSize = 13
compass.TextXAlignment = Enum.TextXAlignment.Left
compass.TextColor3 = Color3.fromRGB(255, 255, 255)
compass.Text = "TRUE HEADING 000° N"
compass.Parent = panel

local axes = Instance.new("TextLabel")
axes.BackgroundTransparency = 1
axes.Position = UDim2.fromOffset(14, 98)
axes.Size = UDim2.new(1, -28, 0, 24)
axes.Font = Enum.Font.Gotham
axes.TextSize = 11
axes.TextWrapped = true
axes.TextXAlignment = Enum.TextXAlignment.Left
axes.TextColor3 = Color3.fromRGB(180, 185, 195)
axes.Text = "TRUE N -Z  •  S +Z  •  E +X  •  W -X"
axes.Parent = panel

local function currentCharacter()
	local character = player.Character
	if not character then
		return nil
	end

	rootPart = character:FindFirstChild("HumanoidRootPart")
	humanoid = character:FindFirstChildOfClass("Humanoid")
	return character
end

local function stopFlight()
	flying = false

	if rootPart and rootPart.Parent then
		rootPart.Anchored = false
	end

	if humanoid and humanoid.Parent then
		humanoid.AutoRotate = true
		humanoid.PlatformStand = false
	end
end

local function startFlight()
	if not currentCharacter() or not rootPart or not humanoid then
		return
	end

	flying = true
	humanoid.AutoRotate = false
	humanoid.PlatformStand = true
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	rootPart.Anchored = true
end

local function toggleFlight()
	if flying then
		stopFlight()
	else
		startFlight()
	end
end

local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.FilterDescendantsInstances = { Workspace.Terrain }
terrainParams.IgnoreWater = false

local function terrainY(x, z)
	local result = Workspace:Raycast(
		Vector3.new(x, 5000, z),
		Vector3.new(0, -10000, 0),
		terrainParams
	)

	return result and result.Position.Y or 50
end

local function teleportToSpawn()
	if not currentCharacter() or not rootPart then
		return
	end

	-- Use the actual reflected runtime spawn instead of the old StreetData index.
	local spawn = Workspace:FindFirstChild("ChesterCitySpawn")
	if not spawn then
		return
	end

	local destination = CFrame.new(
		spawn.Position.X,
		spawn.Position.Y + 18,
		spawn.Position.Z
	)

	if flying then
		rootPart.CFrame = destination
	else
		player.Character:PivotTo(destination)
	end
end

local function setKey(input, value)
	local code = input.KeyCode

	if code == Enum.KeyCode.W then
		pressed.W = value
	elseif code == Enum.KeyCode.A then
		pressed.A = value
	elseif code == Enum.KeyCode.S then
		pressed.S = value
	elseif code == Enum.KeyCode.D then
		pressed.D = value
	elseif code == Enum.KeyCode.Space then
		pressed.Space = value
	elseif code == Enum.KeyCode.LeftControl or code == Enum.KeyCode.RightControl then
		pressed.Control = value
	elseif code == Enum.KeyCode.LeftShift or code == Enum.KeyCode.RightShift then
		pressed.Shift = value
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.F then
		toggleFlight()
		return
	end

	if input.KeyCode == Enum.KeyCode.X then
		teleportToSpawn()
		return
	end

	setKey(input, true)
end)

UserInputService.InputEnded:Connect(function(input)
	setKey(input, false)
end)

player.CharacterAdded:Connect(function()
	stopFlight()
	rootPart = nil
	humanoid = nil
	task.wait(0.5)
	currentCharacter()
end)

local function flatDirection(vector)
	local v = Vector3.new(vector.X, 0, vector.Z)

	if v.Magnitude < 0.001 then
		return GeoOrientation.NORTH
	end

	return v.Unit
end

RunService.RenderStepped:Connect(function(dt)
	camera = Workspace.CurrentCamera or camera

	if not rootPart or not rootPart.Parent then
		currentCharacter()
	end

	if rootPart then
		local p = rootPart.Position
		coords.Text = string.format(
			"X %7.0f   Y %5.0f   Z %7.0f",
			p.X,
			p.Y,
			p.Z
		)
	end

	if camera then
		local h =
			GeoOrientation.headingDegrees(
				flatDirection(camera.CFrame.LookVector)
			)

		compass.Text = string.format(
			"TRUE HEADING %03d° %s",
			math.floor(h + 0.5),
			GeoOrientation.headingName(h)
		)
	end

	if flying and rootPart and camera then
		local forward =
			flatDirection(camera.CFrame.LookVector)

		local right =
			flatDirection(camera.CFrame.RightVector)

		local move = Vector3.zero

		if pressed.W then move += forward end
		if pressed.S then move -= forward end
		if pressed.D then move += right end
		if pressed.A then move -= right end

		if move.Magnitude > 1 then
			move = move.Unit
		end

		local horizontalSpeed =
			pressed.Shift and BOOST_SPEED or BASE_SPEED

		local verticalSpeed =
			pressed.Shift and BOOST_VERTICAL_SPEED or VERTICAL_SPEED

		local vertical = 0
		if pressed.Space then vertical += 1 end
		if pressed.Control then vertical -= 1 end

		local displacement =
			move * horizontalSpeed * dt
			+ Vector3.new(
				0,
				vertical * verticalSpeed * dt,
				0
			)

		rootPart.CFrame =
			rootPart.CFrame + displacement

		rootPart.AssemblyLinearVelocity =
			Vector3.zero

		rootPart.AssemblyAngularVelocity =
			Vector3.zero

		status.Text =
			pressed.Shift
			and "FLYING — BOOST  •  F: Land  •  X: 9th & Kerlin"
			or "FLYING  •  Shift: Boost  •  F: Land  •  X: 9th & Kerlin"
	else
		status.Text =
			"F: Fly  •  X: 9th & Kerlin"
	end
end)

print("[ChesterWorld] True-geographic Studio inspector loaded.")
]]></string>
            </Properties>
          </Item>
          <Item class="LocalScript" referent="1661">
            <Properties>
              <string name="Name">HUDToggle</string>
              <string name="Source"><![CDATA[-- ChesterWorld unified, per-player HUD visibility toggle.
-- H toggles both top road name and bottom flight inspector.
-- A small always-visible button works on touch and mouse.
-- Flight/teleport key controls keep working with the HUD hidden.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local guiParent = player:WaitForChild("PlayerGui")

if player:GetAttribute("CW_HUDVisible") == nil then
    player:SetAttribute("CW_HUDVisible", true)
end

local gui = Instance.new("ScreenGui")
gui.Name = "ChesterHUDToggle"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.DisplayOrder = 100
gui.Parent = guiParent

local button = Instance.new("TextButton")
button.Name = "ToggleHUD"
button.AnchorPoint = Vector2.new(1, 0)
button.Position = UDim2.new(1, -14, 0, 16)
button.Size = UDim2.fromOffset(104, 36)
button.BackgroundColor3 = Color3.fromRGB(17, 21, 26)
button.BackgroundTransparency = 0.13
button.BorderSizePixel = 0
button.Font = Enum.Font.GothamBold
button.TextSize = 12
button.TextColor3 = Color3.fromRGB(250, 250, 250)
button.AutoButtonColor = true
button.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 9)
corner.Parent = button

local function refresh()
    local visible = player:GetAttribute("CW_HUDVisible") ~= false
    button.Text = visible and "H  Hide HUD" or "H  Show HUD"
    button:SetAttribute("CW_HUDVisible", visible)
end

local function toggle()
    player:SetAttribute("CW_HUDVisible",
        not (player:GetAttribute("CW_HUDVisible") ~= false))
end

button.Activated:Connect(toggle)
UserInputService.InputBegan:Connect(function(input, processed)
    if processed or input.KeyCode ~= Enum.KeyCode.H then return end
    if UserInputService:GetFocusedTextBox() then return end
    toggle()
end)

player:GetAttributeChangedSignal("CW_HUDVisible"):Connect(refresh)
refresh()
print("[ChesterWorld HUD] Press H or tap the top-right button to hide/show HUDs.")
]]></string>
            </Properties>
          </Item>
          <Item class="LocalScript" referent="1662">
            <Properties>
              <string name="Name">LocationHUD</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GeoOrientation = require(Shared:WaitForChild("GeoOrientation"))

-- Regional Bootstrap prepares the complete road graph before creating
-- ChesterWorld. A bounded wait avoids false "Infinite yield possible" spam.
local world = Workspace:WaitForChild("ChesterWorld", 180)
if not world then
    warn("[ChesterWorld HUD] World didn't initialize within 180 seconds.")
    return
end

local SEARCH_RADIUS = 95
local INTERSECTION_DISTANCE = 38
local UPDATE_INTERVAL = 0.18

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
overlap.FilterDescendantsInstances = { world }
overlap.MaxParts = 180

local gui = Instance.new("ScreenGui")
gui.Name = "ChesterLocationHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.DisplayOrder = 15
gui.Parent = player:WaitForChild("PlayerGui")

-- Shared HUD visibility. H button is owned by HUDToggle.client.lua.
local function updateHUDVisibility()
    gui.Enabled = player:GetAttribute("CW_HUDVisible") ~= false
end
player:GetAttributeChangedSignal("CW_HUDVisible"):Connect(updateHUDVisibility)
updateHUDVisibility()

local panel = Instance.new("Frame")
panel.Name = "LocationPanel"
panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position = UDim2.new(0.5, 0, 0, 16)
panel.Size = UDim2.fromOffset(430, 92)
panel.BackgroundColor3 = Color3.fromRGB(10, 12, 15)
panel.BackgroundTransparency = 0.18
panel.BorderSizePixel = 0
panel.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 11)
corner.Parent = panel

local city = Instance.new("TextLabel")
city.BackgroundTransparency = 1
city.Position = UDim2.fromOffset(14, 8)
city.Size = UDim2.new(1, -28, 0, 20)
city.Font = Enum.Font.GothamBold
city.TextSize = 13
city.TextXAlignment = Enum.TextXAlignment.Center
city.TextColor3 = Color3.fromRGB(200, 205, 214)
city.Text = "CHESTER, PA"
city.Parent = panel

local location = Instance.new("TextLabel")
location.BackgroundTransparency = 1
location.Position = UDim2.fromOffset(14, 27)
location.Size = UDim2.new(1, -28, 0, 32)
location.Font = Enum.Font.GothamBlack
location.TextSize = 23
location.TextXAlignment = Enum.TextXAlignment.Center
location.TextColor3 = Color3.fromRGB(255, 255, 255)
location.Text = "LOCATING..."
location.Parent = panel

local detail = Instance.new("TextLabel")
detail.BackgroundTransparency = 1
detail.Position = UDim2.fromOffset(14, 61)
detail.Size = UDim2.new(1, -28, 0, 20)
detail.Font = Enum.Font.GothamMedium
detail.TextSize = 11
detail.TextXAlignment = Enum.TextXAlignment.Center
detail.TextColor3 = Color3.fromRGB(170, 177, 188)
detail.Text = "RUNTIME ROAD HUD • TRUE NORTH -Z"
detail.Parent = panel

local function trim(text)
	return (tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function normalizeStreet(raw)
	local s = trim(raw)
	if s == "" or s:lower() == "road" then
		return nil
	end

	local upper = string.upper(s)

	-- Collapse common suffix variants so "Barclay" and "Barclay St"
	-- are treated as the same rendered street.
	upper = upper:gsub("%s+STREET$", "")
	upper = upper:gsub("%s+ST$", "")
	upper = upper:gsub("%s+AVENUE$", "")
	upper = upper:gsub("%s+AVE$", "")
	upper = upper:gsub("%s+ROAD$", "")
	upper = upper:gsub("%s+RD$", "")
	upper = upper:gsub("%s+BOULEVARD$", "")
	upper = upper:gsub("%s+BLVD$", "")

	return trim(upper)
end

local function horizontalDistanceToPart(position, part)
	local localPoint = part.CFrame:PointToObjectSpace(position)
	local hx = part.Size.X * 0.5
	local hz = part.Size.Z * 0.5

	local dx = math.max(math.abs(localPoint.X) - hx, 0)
	local dz = math.max(math.abs(localPoint.Z) - hz, 0)

	return math.sqrt(dx * dx + dz * dz)
end

local function numberedStreet(name)
	return name and name:match("^%d") ~= nil
end

local function pairLabel(a, b)
	if not b then
		return a
	end

	-- Chester locals naturally say "9TH & PARKER", so put numbered
	-- streets first when only one side is numbered.
	if numberedStreet(a) and not numberedStreet(b) then
		return a .. " & " .. b
	elseif numberedStreet(b) and not numberedStreet(a) then
		return b .. " & " .. a
	end

	return a .. " & " .. b
end

local function headingInfo()
	local camera = Workspace.CurrentCamera
	if not camera then
		return 0, "N"
	end

	local look = camera.CFrame.LookVector
	local heading = GeoOrientation.headingDegrees(look)
	return heading, GeoOrientation.headingName(heading)
end

local function resolveLocation(position)
	local nearby = Workspace:GetPartBoundsInRadius(
		position,
		SEARCH_RADIUS,
		overlap
	)

	local bestByStreet = {}

	for _, part in ipairs(nearby) do
		if part:IsA("BasePart") then
			local rawStreet = part:GetAttribute("ChesterStreet")

			if rawStreet == nil then
				-- Fallback for generated Road Parts whose Name is the street.
				local parent = part.Parent
				if parent and parent.Name == "Roads" then
					rawStreet = part.Name
				end
			end

			local street = normalizeStreet(rawStreet)
			if street then
				local d = horizontalDistanceToPart(position, part)
				local current = bestByStreet[street]

				if current == nil or d < current then
					bestByStreet[street] = d
				end
			end
		end
	end

	local ranked = {}
	for street, distance in pairs(bestByStreet) do
		table.insert(ranked, {
			street = street,
			distance = distance,
		})
	end

	table.sort(ranked, function(a, b)
		if math.abs(a.distance - b.distance) > 0.05 then
			return a.distance < b.distance
		end
		return a.street < b.street
	end)

	if #ranked == 0 then
		return "CHESTER", nil, nil
	end

	local first = ranked[1]
	local second = ranked[2]

	if second and second.distance <= INTERSECTION_DISTANCE then
		return pairLabel(first.street, second.street), first, second
	end

	return first.street, first, nil
end

local elapsed = 0

RunService.RenderStepped:Connect(function(dt)
	elapsed += dt
	if elapsed < UPDATE_INTERVAL then
		return
	end
	elapsed = 0

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		location.Text = "LOCATING..."
		return
	end

	local label, first, second = resolveLocation(rootPart.Position)
	location.Text = label

	local heading, cardinal = headingInfo()

	if first then
		if second then
			detail.Text = string.format(
				"RUNTIME ROADS • %03d° %s • N -Z • %.0f/%.0f studs",
				math.floor(heading + 0.5),
				cardinal,
				first.distance,
				second.distance
			)
		else
			detail.Text = string.format(
				"RUNTIME ROAD • %03d° %s • TRUE N -Z • %.0f studs",
				math.floor(heading + 0.5),
				cardinal,
				first.distance
			)
		end
	else
		detail.Text = string.format(
			"RUNTIME ROAD HUD • %03d° %s • TRUE N -Z",
			math.floor(heading + 0.5),
			cardinal
		)
	end
end)

print("[ChesterWorld] Runtime road HUD loaded — north=-Z, rendered roads are source of truth.")
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
    <Item class="Workspace" referent="1663">
      <Properties>
        <string name="Name">Workspace</string>
        <bool name="NeedsPivotMigration">false</bool>
        <bool name="StreamingEnabled">true</bool>
      </Properties>
    </Item>
