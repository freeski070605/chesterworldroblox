-- ChesterWorld — RoadTerrainConformer.server.lua
--
-- Makes generated road Parts conform to the imported Roblox Terrain after all
-- regional tiles are built.
--
-- LOCKED WORLD TRUTH:
--   North = -Z
--   South = +Z
--   East  = +X
--   West  = -X
--
-- This script does NOT modify terrain. It moves/tilts generated road Parts.
-- It is intentionally conservative and can be disabled with ENABLED = false.

local Workspace = game:GetService("Workspace")

local ENABLED = true

-- Visible asphalt sits this far above sampled terrain.
local SURFACE_LIFT = 0.22

-- Minimum road length to slope-align. Tiny pads are Y-adjusted only.
local MIN_SLOPE_LENGTH = 8

-- Terrain ray bounds.
local RAY_START_Y = 2048
local RAY_DISTANCE = 4096

-- We sample slightly inside the endpoints to avoid grabbing terrain from the
-- neighboring road/intersection rather than the segment itself.
local END_FRACTION = 0.44
local WIDTH_FRACTION = 0.38

-- Wait until Bootstrap has had time to finish creating tile folders.
local STABLE_CHECK_SECONDS = 0.75
local STABLE_CHECKS_REQUIRED = 3
local MAX_WAIT_SECONDS = 60

if not ENABLED then
	return
end

local terrain = Workspace.Terrain

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = {terrain}
rayParams.IgnoreWater = false

local function terrainY(x: number, z: number): number?
	local origin = Vector3.new(x, RAY_START_Y, z)
	local direction = Vector3.new(0, -RAY_DISTANCE, 0)

	local result = Workspace:Raycast(origin, direction, rayParams)
	if not result then
		return nil
	end

	return result.Position.Y
end

local function collectRoadParts(world: Instance)
	local roads = {}

	for _, tileFolder in ipairs(world:GetChildren()) do
		local roadFolder = tileFolder:FindFirstChild("Roads")
		if roadFolder then
			for _, obj in ipairs(roadFolder:GetDescendants()) do
				if obj:IsA("BasePart") then
					table.insert(roads, obj)
				end
			end
		end
	end

	return roads
end

local function waitForStableWorld(world: Instance)
	local lastCount = -1
	local stable = 0
	local elapsed = 0

	while elapsed < MAX_WAIT_SECONDS do
		local count = #collectRoadParts(world)

		if count > 0 and count == lastCount then
			stable += 1
			if stable >= STABLE_CHECKS_REQUIRED then
				return count
			end
		else
			stable = 0
			lastCount = count
		end

		task.wait(STABLE_CHECK_SECONDS)
		elapsed += STABLE_CHECK_SECONDS
	end

	return #collectRoadParts(world)
end

local function horizontalUnit(v: Vector3): Vector3?
	local h = Vector3.new(v.X, 0, v.Z)
	if h.Magnitude < 0.0001 then
		return nil
	end
	return h.Unit
end

local function roadAxes(part: BasePart)
	-- Infer which local horizontal axis carries the segment length.
	if part.Size.X >= part.Size.Z then
		return "X", part.Size.X, part.Size.Z, part.CFrame.RightVector
	else
		-- LookVector is local -Z; sign does not matter for a symmetric road Part.
		return "Z", part.Size.Z, part.Size.X, part.CFrame.LookVector
	end
end

local function buildFrameForAxis(
	position: Vector3,
	axisKind: string,
	longAxis: Vector3
): CFrame
	local yAxis = Vector3.new(0, 1, 0)

	if axisKind == "X" then
		local right = longAxis.Unit
		local back = right:Cross(yAxis)

		if back.Magnitude < 0.0001 then
			return CFrame.new(position)
		end

		back = back.Unit
		local up = back:Cross(right).Unit

		return CFrame.fromMatrix(position, right, up, back)
	else
		-- longAxis represents LookVector = -local Z.
		local back = -longAxis.Unit
		local right = yAxis:Cross(back)

		if right.Magnitude < 0.0001 then
			return CFrame.new(position)
		end

		right = right.Unit
		local up = back:Cross(right).Unit

		return CFrame.fromMatrix(position, right, up, back)
	end
end

local function sampleCrossSection(
	center: Vector3,
	sideAxis: Vector3,
	halfWidth: number
): number?
	local offset = sideAxis * (halfWidth * WIDTH_FRACTION)

	local a = terrainY(center.X, center.Z)
	local b = terrainY(center.X + offset.X, center.Z + offset.Z)
	local c = terrainY(center.X - offset.X, center.Z - offset.Z)

	local best = nil
	for _, value in ipairs({a, b, c}) do
		if value ~= nil and (best == nil or value > best) then
			best = value
		end
	end

	return best
end

local function conformRoad(part: BasePart)
	local axisKind, length, width, rawLongAxis = roadAxes(part)
	local longHorizontal = horizontalUnit(rawLongAxis)

	if not longHorizontal then
		return false, "bad_axis"
	end

	-- Side axis stays horizontal.
	local sideHorizontal = Vector3.new(
		-longHorizontal.Z,
		0,
		longHorizontal.X
	)

	local centerXZ = Vector3.new(part.Position.X, 0, part.Position.Z)
	local endpointOffset = longHorizontal * (length * END_FRACTION)

	local startXZ = centerXZ - endpointOffset
	local endXZ = centerXZ + endpointOffset

	local halfWidth = width / 2

	local startGround = sampleCrossSection(
		startXZ,
		sideHorizontal,
		halfWidth
	)
	local centerGround = sampleCrossSection(
		centerXZ,
		sideHorizontal,
		halfWidth
	)
	local endGround = sampleCrossSection(
		endXZ,
		sideHorizontal,
		halfWidth
	)

	if not startGround or not centerGround or not endGround then
		return false, "no_terrain"
	end

	local halfThickness = part.Size.Y / 2
	local yOffset = halfThickness + SURFACE_LIFT

	local startY = startGround + yOffset
	local centerY = centerGround + yOffset
	local endY = endGround + yOffset

	if length < MIN_SLOPE_LENGTH then
		-- Tiny connector/pad: keep its yaw exactly, just put it above terrain.
		local targetY = math.max(startY, centerY, endY)
		part.CFrame = CFrame.new(
			part.Position.X,
			targetY,
			part.Position.Z
		) * (part.CFrame - part.CFrame.Position)

		part:SetAttribute("CW_TerrainConformed", true)
		return true, "raised"
	end

	local horizontalDistance = (endXZ - startXZ).Magnitude
	if horizontalDistance < 0.001 then
		return false, "too_short"
	end

	-- Slope the long axis from endpoint terrain samples.
	local rise = endY - startY
	local run = horizontalDistance

	local long3 = Vector3.new(
		longHorizontal.X * run,
		rise,
		longHorizontal.Z * run
	).Unit

	-- The straight endpoint plane can still sit below a terrain hump at center.
	-- Lift the whole segment enough that the sampled center remains visible.
	local endpointMidY = (startY + endY) / 2
	local extraLift = math.max(0, centerY - endpointMidY)

	local targetPosition = Vector3.new(
		part.Position.X,
		endpointMidY + extraLift,
		part.Position.Z
	)

	part.CFrame = buildFrameForAxis(
		targetPosition,
		axisKind,
		long3
	)

	part:SetAttribute("CW_TerrainConformed", true)
	part:SetAttribute("CW_TerrainExtraLift", extraLift)

	return true, "sloped"
end

local world = Workspace:WaitForChild("ChesterWorld")

local stableRoadCount = waitForStableWorld(world)
local roads = collectRoadParts(world)

local conformed = 0
local raised = 0
local sloped = 0
local noTerrain = 0
local failed = 0

for index, road in ipairs(roads) do
	local ok, mode = conformRoad(road)

	if ok then
		conformed += 1
		if mode == "raised" then
			raised += 1
		elseif mode == "sloped" then
			sloped += 1
		end
	else
		if mode == "no_terrain" then
			noTerrain += 1
		else
			failed += 1
		end
	end

	-- Yield periodically so a full regional pass does not freeze the server.
	if index % 400 == 0 then
		task.wait()
	end
end

print(string.format(
	"[ChesterWorld RoadTerrainConformer] stable=%d current=%d conformed=%d sloped=%d raised=%d noTerrain=%d failed=%d",
	stableRoadCount,
	#roads,
	conformed,
	sloped,
	raised,
	noTerrain,
	failed
))
